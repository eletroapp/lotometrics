function desdobJogoValido(jogo, c, tamanho){
  if(c.maxConsecutivos && !validarSequencia(jogo, c)) return false;
  const fator = tamanho / c.dezenasPorJogo;
  const somaMin = Math.round(c.somaMin * fator);
  const somaMax = Math.round(c.somaMax * fator);
  return validarSoma(jogo, { somaMin, somaMax });
}

function desdobSortear(universo, tamanho, c, maxTentativas){
  for(let t = 0; t < (maxTentativas || 400); t++){
    const jogo = sortearJogoAleatorio(universo, tamanho).sort((a,b)=>a-b);
    if(desdobJogoValido(jogo, c, tamanho)) return jogo;
  }
  return null;
}

function gerarDesdobramento(){
  const c = desdobConf();
  const d = state.desdobramento;
  const universo = [...d.selecionadas];
  const tamanho = d.tamanho;
  const quantidadeInput = parseInt(document.getElementById("desdobQtd").value, 10) || 1;
  const quantidade = Math.min(Math.max(quantidadeInput, 1), 1000);

  const jogos = [];
  const vistos = new Set();
  const limiteGlobal = Math.max(quantidade * 300, 3000);
  let tentativas = 0, falhasSeguidas = 0;
  const inicio = Date.now();
  while(jogos.length < quantidade && tentativas < limiteGlobal){
    tentativas++;
    // trava de segurança: não deixa a tela congelar se as dezenas escolhidas não permitem cumprir os filtros
    if((tentativas & 15) === 0 && Date.now() - inicio > 10000) break;
    const jogo = desdobSortear(universo, tamanho, c);
    if(!jogo){ if(++falhasSeguidas >= 300) break; continue; }
    falhasSeguidas = 0;
    const chave = jogo.join(",");
    if(vistos.has(chave)) continue;
    vistos.add(chave);
    jogos.push(jogo);
  }
  return { jogos, quantidade };
}

