      return (j.extra != null && chkExtraAtiva()) ? `${linha}  + extra ${pad(j.extra)}` : linha;
    }).join("\n");
  } else if(state.modo === "cascata-megasena"){
    texto = state.cascataMSJogos.map(j => j.resultado.map(pad).join(" ")).join("\n");
  } else if(state.modo === "cascata-duplasena"){
    texto = state.cascataDSJogos.map(j => j.resultado.map(pad).join(" ")).join("\n");
  } else if(state.modo === "cascata-diadesorte"){
    texto = state.cascataDiaJogos.map(j => j.resultado.map(pad).join(" ")).join("\n");
  } else if(state.modo === "desdobramento"){
    texto = state.desdobramento.jogos.map(j => j.map(pad).join(" ")).join("\n");
  } else if(state.modo === "analise"){
    texto = state.analise.jogos.map(j => j.map(pad).join(" ")).join("\n");
  } else {
    texto = state.jogos.map((j,i) => {
      const linha = j.map(pad).join(" ");
