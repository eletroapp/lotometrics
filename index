/* ============ Cascata Lotofácil: render + ações ============ */
function renderCascata(){
  document.getElementById("qtdCascataBadge").textContent = `${state.cascataJogos.length} jogos`;
  const empty = document.getElementById("emptyStateCascata");
  const list = document.getElementById("cascataList");

  if(state.cascataJogos.length === 0){
    empty.style.display = "flex";
    list.style.display = "none";
    list.innerHTML = "";
    return;
  }
  empty.style.display = "none";
  list.style.display = "block";

  const etapasOrdem = [
    { chave: "t23", n: 23, l: "base" },
    { chave: "t21", n: 21, l: "ramo" },
    { chave: "t20", n: 20, l: "jogo" },
    { chave: "t19", n: 19, l: "jogo" },
    { chave: "t18", n: 18, l: "jogo" },
    { chave: "t17", n: 17, l: "padrão" },
  ];

  const qtdDezenas = state.cascataJogos[0].resultado.length;
  const extraAtiva = chkExtraAtiva();
  const colsDezenas = Array.from({length: qtdDezenas}, (_, i) => `<th>D${i+1}</th>`).join("");

  const linhas = state.cascataJogos.map((j, i) => {
    const incluirExtra = j.extra != null && extraAtiva;
    const soma = j.resultado.reduce((a,b)=>a+b,0) + (incluirExtra ? j.extra : 0);
    const dezenasCells = j.resultado.map(n => `<td class="num-cell">${pad(n)}</td>`).join("");
    const extraCell = j.extra != null
      ? `<td class="num-cell num-extra">${extraAtiva ? pad(j.extra) : "—"}</td>`
      : "";

    const etapasPresentes = etapasOrdem.filter(e => j[e.chave]);
    const trilhaHtml = etapasPresentes.map((e, idx) => {
      const isUltima = idx === etapasPresentes.length - 1;
      const bloco = `<div class="trilha-etapa"${isUltima ? ' style="border-color:var(--accent-lotofacil);"' : ''}><span class="n">${e.n}</span><span class="l">${e.l}</span></div>`;
      return idx === 0 ? bloco : `<span class="trilha-seta">→</span>${bloco}`;
    }).join("");
    const detalheHtml = etapasPresentes.map(e =>
      `${e.n} dezenas: ${j[e.chave].map(pad).join(", ")}`
    ).join("<br>");

    return `
      <tr class="cascata-row">
        <td>${pad(i+1)}</td>
        ${dezenasCells}${extraCell}
        <td class="soma-cell">${soma}</td>
        <td class="trilha-cell"><button type="button" class="btn-trilha-toggle" onclick="toggleCascataTrilha(${i})">trilha</button></td>
      </tr>
      <tr class="cascata-trilha-row" id="cascataTrilha${i}">
        <td colspan="${2 + qtdDezenas + (j.extra != null ? 1 : 0)}">
          <div class="trilha">${trilhaHtml}</div>
          <div style="margin-top:.5rem; font-size:11px; color:var(--muted-foreground); line-height:1.6;">
            ${detalheHtml}
          </div>
        </td>
      </tr>
    `;
  }).join("");

  list.innerHTML = `
    <table class="cascata-table">
      <thead>
        <tr>
          <th>#</th>
          ${colsDezenas}
          ${state.cascataJogos[0].extra != null ? "<th>Extra</th>" : ""}
          <th>Soma</th>
          <th></th>
        </tr>
      </thead>
      <tbody>${linhas}</tbody>
    </table>
  `;
}

function toggleCascataTrilha(idx){
  const row = document.getElementById(`cascataTrilha${idx}`);
  if(row) row.classList.toggle("show");
}

