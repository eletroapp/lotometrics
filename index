  return '<section class="panel"><h3 class="an-h4">Montar jogos a partir das análises</h3>' +
    '<p class="an-note" style="margin-top:.4rem;">Escolha uma ou mais análises. <strong>Preferências</strong> mudam a chance de cada dezena entrar no jogo (sorteio ponderado); <strong>filtros</strong> só aceitam jogos cuja característica cai na <em>faixa típica</em> calculada de forma exata para o tamanho de jogo escolhido. Tudo é gerado sobre a amostra carregada de ' + R.T + ' concursos.</p>' +
    '<p class="an-note" style="margin-top:.75rem;"><strong>Preferências (pesos)</strong></p><div class="an-checks">' + chk("peso") + '</div>' +
    '<p class="an-note" style="margin-top:.9rem;"><strong>Filtros (faixas típicas exatas)</strong></p><div class="an-checks">' + chk("filtro") + '</div>' +
    '<div class="row-wrap" style="margin-top:1rem;align-items:flex-end;gap:1rem;">' +
      '<div class="field"><label class="field-label">Tamanho do jogo</label><select class="select input-h" style="width:9rem;margin-top:.5rem;" data-an-f="tamJogo">' + opts.join("") + '</select></div>' +
      '<div class="field"><label class="field-label">Faixa típica</label><select class="select input-h" style="width:9rem;margin-top:.5rem;" data-an-f="faixa">' +
        [0.7, 0.8, 0.9].map(m => '<option value="' + m + '"' + (a.faixa === m ? " selected" : "") + '>' + Math.round(m * 100) + '% centrais</option>').join("") + '</select></div>' +
      '<div class="field"><label class="field-label">Quantidade (máx. 1000)</label><input id="anQtd" data-an-f="qtdJogos" type="number" min="1" max="1000" value="' + a.qtdJogos + '" class="input input-h" style="width:9rem;"></div>' +
      '<button class="btn btn-primary" data-an="gerar" style="height:2.75rem;">Gerar jogos</button>' +
    '</div>' +
    '<p class="an-note" style="margin-top:.75rem;">Aviso: estas faixas descrevem combinações “comuns”; elas não aumentam a probabilidade de acerto de um jogo — todo jogo de mesmo tamanho tem a mesma chance.</p></section>' +
    '<section class="panel"><div class="results-head"><h3>Jogos gerados</h3><div class="jogo-meta"><span class="badge-count">' + jogos.length + ' jogos</span><button class="btn btn-ghost btn-sm" data-an="limpar"' + (jogos.length ? "" : " disabled") + '>Limpar</button></div></div>' +
    (jogos.length ? (a.info ? '<p class="an-note" style="margin-top:.4rem;">' + jogos.length + ' jogos únicos de ' + a.info.n + ' dezenas em ' + a.info.tentativas.toLocaleString("pt-BR") + ' tentativas. Use <strong>Copiar</strong> e <strong>PDF</strong> (no topo) para levar todos.</p>' : '') +
      '<ul class="jogos-list">' + lista + '</ul>' + (jogos.length > show.length ? '<button class="btn btn-secondary" data-an="mais" style="margin-top:1rem;">Mostrar mais 100 (' + show.length + ' de ' + jogos.length + ')</button>' : '')
      : '<div class="empty-state"><p>Nenhum jogo gerado ainda</p><p>Marque as análises desejadas acima e clique em “Gerar jogos”.</p></div>') +
    '</section>';
}

