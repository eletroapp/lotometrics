        : "";
      if(linhasComuns.length){
        info.style.display = "";
        info.innerHTML = linhasComuns.join("");
      } else {
        info.style.display = "none";
        info.innerHTML = "";
      }
    } else {
      // NORMAL → houve ganhador(es) na faixa principal: mostra quantos e quanto cada um levou
      const g = status.ganhadoresPrincipal ?? 0;
      const porGanhador = status.faixa ? status.faixa.valorPorGanhador : null;
      const labelCadaUm = g === 1 ? "O ganhador levou" : "Cada um ganhou";
      label.textContent = status.numeroAtual ? `Concurso #${status.numeroAtual} premiado` : "Concurso premiado";
      card.querySelector(".jackpot-valor").textContent = `${g} ${g === 1 ? "ganhador" : "ganhadores"}`;
      card.querySelector(".jackpot-concurso").textContent = status.faixa ? status.faixa.descricao : "Faixa principal";
      info.style.display = "";
      info.innerHTML = `
        <div class="jackpot-info-row"><span>${labelCadaUm}</span><span>${formatarMoedaExata(porGanhador)}</span></div>
