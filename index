}

/**
 * Escreve uma linha de jogo no PDF, quebrando automaticamente em múltiplas
 * linhas quando o texto não cabe na largura da página (isso é o que
 * causava o corte dos jogos da Lotomania, que têm 50 dezenas por jogo).
 * Retorna o novo valor de y após imprimir (já considerando quebras de página).
 */
function pdfEscreverLinha(doc, texto, x, y, opts){
  const o = Object.assign({ fontSize: 10, lineHeight: 5.5, marginBottom: 18, marginRight: 14, indent: 0 }, opts || {});
  doc.setFontSize(o.fontSize);
  const pageWidth = doc.internal.pageSize.getWidth();
  const pageHeight = doc.internal.pageSize.getHeight();
  const maxWidth = pageWidth - x - o.indent - o.marginRight;
  const linhas = doc.splitTextToSize(texto, maxWidth);
  linhas.forEach((linha, idx) => {
    if(y > pageHeight - o.marginBottom){
      doc.addPage();
      y = 20;
    }
    doc.text(linha, x + (idx > 0 ? o.indent : 0), y);
    y += o.lineHeight;
  });
  return y;
}

