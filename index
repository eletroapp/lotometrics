const LTF_EXTRA_RANK17 = 16;

function ltfIsSubset(sub, sup){
  const s = new Set(sup);
  return sub.every(v => s.has(v));
}
function ltfEscolher(arr){
  return arr[Math.floor(Math.random() * arr.length)];
}
function ltfRemoverAleatorio(arr, qtdRemover){
  const pool = [...arr];
  for(let i=0; i<qtdRemover && pool.length; i++){
    pool.splice(Math.floor(Math.random()*pool.length), 1);
  }
  return pool.sort((a,b)=>a-b);
}

/* Gera 1 jogo pela cascata, parando no tamanho pedido (20, 19, 18, 17 ou 15).
   20 e 18 não existem como tabela pronta na planilha — são obtidos tirando
   1 dezena aleatória da etapa anterior (21→20 e 19→18), igual você descreveu.
   t23Custom, se informado, substitui o sorteio entre as 3 tabelas prontas. */
function gerarCascataLotofacil(tamanhoAlvo, t23Custom){
  tamanhoAlvo = tamanhoAlvo || 15;

  // Etapa 1: tabela de 23 — a sua, se informada, senão sorteia 1 das 3 prontas
  const t23ord = (t23Custom && t23Custom.length === 23)
    ? [...t23Custom].sort((a,b)=>a-b)
    : [...ltfEscolher(LTF_TABELAS_23)].sort((a,b)=>a-b);

  const trilha = { t23: t23ord };

  // Etapa 2: tabela de 21 — aplica 1 dos 26 padrões posicionais sobre a 23
  const padrao21 = ltfEscolher(LTF_RANKS_21);
  const t21 = padrao21.map(i => t23ord[i]).sort((a,b)=>a-b);
  trilha.t21 = t21;

  if(tamanhoAlvo === 20){
    // Etapa 2b: jogo de 20 — tira 1 dezena aleatória da 21 (novo, não vem da planilha)
    const t20 = ltfRemoverAleatorio(t21, 1);
    return { ...trilha, t20, resultado: t20, extra: null };
  }

  // Etapa 3: jogo de 19 — aplica 1 dos 21 padrões posicionais sobre a 21 (cascata real 21→19)
  const padrao19 = ltfEscolher(LTF_RANKS_19);
  const t19ord = padrao19.map(i => t21[i]).sort((a,b)=>a-b);
  trilha.t19 = t19ord;
  if(tamanhoAlvo === 19) return { ...trilha, resultado: t19ord, extra: null };

  if(tamanhoAlvo === 18){
    // Etapa 3b: jogo de 18 — tira 1 dezena aleatória da 19 (novo, não vem da planilha)
    const t18 = ltfRemoverAleatorio(t19ord, 1);
    return { ...trilha, t18, resultado: t18, extra: null };
  }

  // Etapa 4: padrão posicional 19→17 (um dos 27 da planilha)
  const padrao17 = ltfEscolher(LTF_RANKS_17);
  const t17ord = padrao17.map(i => t19ord[i]).sort((a,b)=>a-b);
  trilha.t17 = t17ord;
  if(tamanhoAlvo === 17) return { ...trilha, resultado: t17ord, extra: null };

  // Etapa 5: padrão posicional 17→15 + extra (um dos 16 da planilha)
  const padrao15 = ltfEscolher(LTF_RANKS_15);
  const jogo15 = padrao15.map(i => t17ord[i]).sort((a,b)=>a-b);
  const extra = t17ord[LTF_EXTRA_RANK17];

  return { ...trilha, resultado: jogo15, extra };
}


