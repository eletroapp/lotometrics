<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LotoMetrics Pro IA — Gerador Inteligente de Jogos</title>
<meta name="description" content="Gere jogos da Mega-Sena, Lotofácil, Dupla Sena, Lotomania e Dia de Sorte com filtros estatísticos, confira acertos e exporte em PDF.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<style>
  :root{
    --radius: 0.875rem;
    --background: #0f1020;
    --foreground: #f1f2f8;
    --surface: #191b32;
    --surface-2: #21233c;
    --primary: #6366f1;
    --primary-foreground: #ffffff;
    --secondary: #262845;
    --secondary-foreground: #f1f2f8;
    --muted-foreground: #9598b3;
    --destructive: #f87171;
    --success: #34d399;
    --border: #2d2f4d;
    --input: #383a5c;
    --ring: #6366f1;
    --on-accent: #14152b;

    --accent-megasena: #16c087;
    --accent-lotofacil: #a855f7;
    --accent-duplasena: #f43f5e;
    --accent-lotomania: #fb923c;
    --accent-diadesorte: #eab308;

    --gradient-hero: linear-gradient(120deg, #4338ca 0%, #4f46e5 55%, #6d28d9 100%);
    --gradient-primary: linear-gradient(120deg, #4f46e5, #6366f1);
    --shadow-panel: 0 1px 0 0 rgba(255,255,255,0.04) inset, 0 18px 44px -24px rgba(0,0,0,0.65);
    --shadow-glow: 0 0 0 1px rgba(99,102,241,0.35), 0 14px 28px -14px rgba(99,102,241,0.4);
    --transition-smooth: 200ms cubic-bezier(0.4, 0, 0.2, 1);

    --sidebar: #131427;
    --sidebar-accent: #242640;
    --sidebar-border: #2d2f4d;
  }
  *{box-sizing:border-box; border-color:var(--border);}
  html,body{margin:0; padding:0;}
  body{
    background-color:var(--background);
    color:var(--foreground);
    font-family:"DM Sans", ui-sans-serif, system-ui, sans-serif;
    -webkit-font-smoothing:antialiased;
    min-height:100vh;
  }
  h1,h2,h3,h4{font-family:"Space Grotesk", ui-sans-serif, system-ui, sans-serif; letter-spacing:-0.02em; margin:0;}
  button{font-family:inherit; cursor:pointer;}
  input, textarea, select{font-family:inherit; color:var(--foreground); background:transparent;}

  :where(button, a, input, textarea, select, summary):focus-visible{
    outline:2px solid color-mix(in oklab, var(--ring) 85%, transparent); outline-offset:2px; border-radius:.5rem;
  }
  ::selection{background:color-mix(in oklab, var(--primary) 45%, transparent);}
  body::before{content:""; position:fixed; inset:0; pointer-events:none; z-index:0;
    background:radial-gradient(60rem 32rem at 78% -12%, rgba(99,102,241,.14), transparent 60%),
               radial-gradient(48rem 28rem at -8% 8%, rgba(168,85,247,.10), transparent 60%);}
  .app{position:relative; z-index:1;}
  .icon{width:1em; height:1em; display:inline-block; vertical-align:-0.125em; stroke:currentColor; fill:none; stroke-width:2; stroke-linecap:round; stroke-linejoin:round;}

  /* ---------- layout ---------- */
  .app{min-height:100vh;}
  .main-wrap{transition:padding-left .2s;}
  @media (min-width:1024px){ .main-wrap{padding-left:18rem;} }
  .main-wrap.full{padding-left:0 !important;}

  /* ---------- navbar (home) ---------- */
  .navbar{
    position:sticky; top:0; z-index:25; display:flex; align-items:center; justify-content:space-between;
    gap:1rem; padding:.875rem 1.25rem; background:rgba(20,21,43,0.85); backdrop-filter:blur(16px);
    border-bottom:1px solid var(--border);
  }
  @media (min-width:640px){ .navbar{padding:1rem 2rem;} }
  .navbar-brand{display:flex; align-items:center; gap:.75rem;}
  .navbar-brand h1{font-size:1.125rem; font-weight:700;}
  .navbar-brand p{font-size:12px; color:var(--muted-foreground);}
  .navbar-tabs{display:flex; flex-wrap:wrap; align-items:center; gap:.5rem; justify-content:flex-end;}
  .navbar-tab{
    position:relative; display:inline-flex; align-items:center; gap:.5rem;
    border:1px solid transparent; border-top:2px solid var(--accent);
    background:transparent; color:var(--accent);
    border-radius:.625rem; padding:.55rem .95rem; font-size:.8125rem; font-weight:600;
    transition:background-color var(--transition-smooth), color var(--transition-smooth), border-color var(--transition-smooth), transform var(--transition-smooth);
  }
  .navbar-tab::before{content:""; position:absolute; left:.75rem; right:.75rem; top:0; height:2px; border-radius:0 0 2px 2px; background:var(--accent); opacity:0; transition:opacity var(--transition-smooth);}
  .navbar-tab:hover{background:color-mix(in oklab, var(--accent) 12%, transparent); transform:translateY(-1px);}
  .navbar-tab.active{background:color-mix(in oklab, var(--accent) 18%, var(--surface-2)); border-color:color-mix(in oklab, var(--accent) 35%, transparent); color:var(--accent);}
  .navbar-tab .tab-dot{display:none;}
  @media (max-width:900px){ .navbar{flex-wrap:wrap;} .navbar-tabs{width:100%; justify-content:flex-start;} }

  /* ---------- sidebar ---------- */
  .sidebar-overlay{position:fixed; inset:0; z-index:30; background:rgba(20,21,45,0.45); backdrop-filter:blur(4px); display:none;}
  .sidebar-overlay.show{display:block;}
  @media (min-width:1024px){ .sidebar-overlay{display:none !important;} }

  .sidebar{
    position:fixed; inset-block:0; left:0; z-index:40;
    width:18rem; display:flex; flex-direction:column;
    border-right:1px solid var(--sidebar-border);
    background:var(--sidebar);
    padding:1.25rem 1rem 1.5rem;
    transform:translateX(-100%);
    transition:transform .3s cubic-bezier(.4,0,.2,1);
    /* correção: permite acessar todos os menus em telas baixas */
    max-height:100vh;
    max-height:100dvh;
    overflow-y:auto;
    overscroll-behavior:contain;
    scrollbar-width:thin;
    scrollbar-color:var(--input) transparent;
    box-shadow:0 24px 60px -30px rgba(0,0,0,.8);
  }
  .sidebar::-webkit-scrollbar{width:8px;}
  .sidebar::-webkit-scrollbar-thumb{background:var(--input); border-radius:99px; border:2px solid var(--sidebar);}
  .sidebar::-webkit-scrollbar-thumb:hover{background:#4a4d75;}
  .sidebar::-webkit-scrollbar-track{background:transparent;}
  .sidebar.open{transform:translateX(0);}
  @media (min-width:1024px){ .sidebar{transform:translateX(0);} }
  .sidebar.hidden-shell{display:none;}

  .sidebar-head{position:sticky; top:-1.25rem; z-index:2; display:flex; align-items:center; justify-content:space-between; gap:.75rem;
    margin:-1.25rem -1rem .25rem; padding:1.25rem 1rem .75rem;
    background:linear-gradient(to bottom, var(--sidebar) 76%, color-mix(in oklab, var(--sidebar) 70%, transparent));
    border-bottom:1px solid var(--sidebar-border);}
  .sidebar-brand{display:flex; align-items:center; gap:.75rem; min-width:0; cursor:pointer;}
  .brand-badge{display:grid; place-items:center; width:2.5rem; height:2.5rem; flex-shrink:0; border-radius:.75rem; background-image:var(--gradient-primary); color:var(--primary-foreground);}
  .sidebar-close{border:none; background:none; padding:.25rem; border-radius:.375rem; color:var(--muted-foreground);}
  .sidebar-close:hover{background:var(--sidebar-accent);}
  @media (min-width:1024px){ .sidebar-close{display:none;} }

  .sidebar-label{margin-top:1.5rem; padding:0 .5rem; font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:.18em; color:var(--muted-foreground);}
  .sidebar-nav{margin-top:.75rem; display:flex; flex-direction:column; gap:.25rem;}
  .nav-item{
    position:relative; display:flex; align-items:center; gap:.75rem; border:1px solid transparent; background:none;
    border-radius:.625rem; padding:.6rem .75rem; text-align:left; font-size:.875rem; font-weight:500;
    color:var(--muted-foreground); transition:background-color var(--transition-smooth), color var(--transition-smooth), border-color var(--transition-smooth);
  }
  .nav-item::before{content:""; position:absolute; left:0; top:50%; width:3px; height:0; border-radius:99px;
    background-image:var(--gradient-primary); transform:translateY(-50%); transition:height var(--transition-smooth);}
  .nav-item:hover{background:var(--sidebar-accent); color:var(--foreground);}
  .nav-item.active{background:linear-gradient(90deg, color-mix(in oklab, var(--primary) 20%, transparent), var(--sidebar-accent));
    border-color:color-mix(in oklab, var(--primary) 28%, transparent); color:var(--foreground); font-weight:600;}
  .nav-item.active::before{height:60%;}
  .nav-badge{display:grid; place-items:center; flex-shrink:0; width:2rem; height:2rem; border-radius:.5rem; font-family:"Space Grotesk"; font-size:11px; font-weight:700; color:var(--on-accent);}
  .nav-name{min-width:0; flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
  .nav-qtd{flex-shrink:0; font-size:11px; font-variant-numeric:tabular-nums; color:var(--muted-foreground);}
  .nav-inicio{margin-top:.75rem; display:flex; align-items:center; gap:.625rem; border:none; background:none; border-radius:.5rem; padding:.625rem .75rem; text-align:left; font-size:.875rem; font-weight:600; color:var(--primary); margin-bottom:.5rem;}
  .nav-inicio:hover{background:var(--sidebar-accent);}

  .sidebar-footer{margin-top:1.5rem; border-radius:.75rem; border:1px solid var(--sidebar-border); background:var(--surface-2); padding:1rem; font-size:12px; line-height:1.6; color:var(--muted-foreground);}

  /* ---------- topbar ---------- */
  .topbar{
    position:sticky; top:0; z-index:20; display:grid; grid-template-columns:minmax(0,1fr) auto;
    align-items:center; gap:1rem; border-bottom:1px solid var(--border);
    background:rgba(20,21,43,0.85); backdrop-filter:blur(20px);
    padding:.75rem 1rem;
  }
  @media (min-width:640px){ .topbar{padding:.75rem 2rem;} }
  .topbar-left{display:flex; min-width:0; align-items:center; gap:.75rem;}
  .menu-btn{flex-shrink:0; border-radius:.5rem; border:1px solid var(--border); background:none; padding:.5rem; color:var(--muted-foreground);}
  .menu-btn:hover{background:var(--secondary);}
  @media (min-width:1024px){ .menu-btn{display:none;} }
  .topbar-title p{font-size:11px; text-transform:uppercase; letter-spacing:.18em; color:var(--muted-foreground);}
  .topbar-title h1{font-size:1.125rem; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
  @media (min-width:640px){ .topbar-title h1{font-size:1.25rem;} }
  .topbar-actions{display:flex; flex-shrink:0; align-items:center; gap:.5rem;}

  /* ---------- buttons ---------- */
  .btn{display:inline-flex; align-items:center; justify-content:center; gap:.5rem; border-radius:.5rem; border:none; font-weight:600; font-size:.875rem; transition:background-color var(--transition-smooth), opacity var(--transition-smooth); white-space:nowrap;}
  .btn:disabled{opacity:.45; cursor:not-allowed;}
  .btn-ghost{background:none; color:var(--foreground); padding:.5rem .75rem;}
  .btn-ghost:hover:not(:disabled){background:var(--secondary);}
  .btn-secondary{background:var(--secondary); color:var(--secondary-foreground); padding:.5rem .9rem;}
  .btn-secondary:hover:not(:disabled){background:#31335a;}
  .btn-primary{background-image:var(--gradient-primary); color:var(--primary-foreground); padding:.75rem 1rem;
    box-shadow:0 10px 22px -12px rgba(99,102,241,.75);}
  .btn-primary:hover:not(:disabled){filter:brightness(1.08); box-shadow:0 14px 26px -12px rgba(99,102,241,.9);}
  .btn-sm{height:2.25rem;}
  .btn-full{width:100%; height:3rem; font-size:1rem;}
  .btn-hide-label{}
  @media (max-width:639px){ .btn-hide-label{display:none;} }

  /* ---------- inputs ---------- */
  .field-label{display:block; font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:.08em; color:var(--muted-foreground);}
  .input, .textarea, .select{
    width:100%; border:1px solid var(--input); background:var(--surface); border-radius:.5rem;
    padding:.5rem .75rem; font-size:.875rem; outline:none; color:var(--foreground);
  }
  .input:focus, .textarea:focus, .select:focus{border-color:var(--ring); box-shadow:0 0 0 2px rgba(79,70,229,0.18);}
  .input-h{height:2.75rem;}
  .textarea{resize:vertical;}

  /* ---------- main content ---------- */
  main{padding:1rem;}
  @media (min-width:640px){ main{padding:2rem;} }
  main > * + *{margin-top:1.5rem;}

  .hero{isolation:isolate; position:relative; overflow:hidden; border-radius:1rem; border:1px solid var(--border); padding:1.5rem; background-image:var(--gradient-hero); color:#fff;}
  @media (min-width:640px){ .hero{padding:2.5rem;} }
  .hero-glow{position:absolute; right:-4rem; top:-6rem; width:20rem; height:20rem; border-radius:9999px; opacity:.35; filter:blur(70px); background:#fff;}
  .hero-eyebrow{position:relative; display:inline-block; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.18em; color:#fff; background:rgba(255,255,255,0.16); padding:.3rem .75rem; border-radius:9999px;}
  .hero h2{position:relative; margin-top:.9rem; max-width:42rem; font-size:1.75rem; font-weight:700; line-height:1.2; color:#fff;}
  @media (min-width:640px){ .hero h2{font-size:2.5rem;} }
  .hero p{position:relative; margin-top:.75rem; max-width:36rem; font-size:.9375rem; color:rgba(255,255,255,0.85);}

  .stat-grid{position:relative; margin-top:1.75rem; display:grid; grid-template-columns:repeat(2,1fr); gap:.75rem;}
  @media (min-width:640px){ .stat-grid{grid-template-columns:repeat(4,1fr);} }
  .stat-card{border-radius:.75rem; border:1px solid rgba(255,255,255,0.25); background:rgba(255,255,255,0.12); backdrop-filter:blur(8px); padding:.75rem 1rem;}
  .stat-card dt{font-size:11px; text-transform:uppercase; letter-spacing:.05em; color:rgba(255,255,255,0.75);}
  .stat-card dd{margin:.25rem 0 0; font-size:1.25rem; font-weight:700; font-variant-numeric:tabular-nums; color:#fff;}

  .grid-cols{display:grid; gap:1.5rem;}
  @media (min-width:1280px){ .grid-cols{grid-template-columns:380px minmax(0,1fr);} }

  .panel{background:linear-gradient(180deg, color-mix(in oklab, var(--surface) 92%, #fff 8%), var(--surface));
    border:1px solid var(--border); border-radius:1.125rem; box-shadow:var(--shadow-panel); padding:1.25rem;}
  @media (min-width:640px){ .panel{padding:1.5rem;} }
  .panel-fit{height:fit-content;}
  .panel h3{font-size:1rem; font-weight:700;}

  .stack{margin-top:1.25rem; display:flex; flex-direction:column; gap:1.25rem;}
  .field{}
  .field .input{margin-top:.5rem;}

  .row-wrap{margin-top:.5rem; display:flex; flex-wrap:wrap; gap:.5rem;}
  .concurso-input{width:8rem;}
  .flex-1{flex:1;}

  .concurso-label{margin-top:.25rem; font-size:12px; font-weight:500;}

  .criterios-box{border-radius:.75rem; border:1px solid var(--border); background:var(--surface-2); padding:1rem;}
  .criterios-box p{font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:.05em; color:var(--muted-foreground);}
  .criterios-box ul{margin:.75rem 0 0; padding:0; list-style:none; display:flex; flex-direction:column; gap:.5rem; font-size:.875rem; color:var(--foreground);}
  .criterios-box li{display:flex; gap:.5rem;}
  .dot{margin-top:.375rem; width:6px; height:6px; flex-shrink:0; border-radius:9999px;}

  .results-head{display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:.75rem;}
  @media (min-width:640px){ .results-head{display:flex; justify-content:space-between;} }
  .results-head h3{overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
  .badge-count{border-radius:9999px; background:var(--secondary); padding:.25rem .75rem; font-size:12px; font-weight:600; font-variant-numeric:tabular-nums;}

  .conferir-box{margin-top:1rem; display:flex; flex-direction:column; gap:.5rem; border-radius:.75rem; border:1px solid var(--border); background:var(--surface-2); padding:.75rem;}
  @media (min-width:640px){ .conferir-box{flex-direction:row;} }

  .empty-state{display:flex; min-height:300px; flex:1; flex-direction:column; align-items:center; justify-content:center; padding:4rem 0; text-align:center;}
  .empty-icon{display:grid; place-items:center; width:3.5rem; height:3.5rem; border-radius:1rem; border:1px solid var(--border); background:var(--surface-2); color:var(--muted-foreground);}
  .empty-state p:first-of-type{margin-top:1rem; font-family:"Space Grotesk"; font-size:1rem; font-weight:600;}
  .empty-state p:last-of-type{margin-top:.25rem; max-width:20rem; font-size:.875rem; color:var(--muted-foreground);}

  .jogos-list{margin:1rem 0 0; padding:0; list-style:none; display:flex; flex-direction:column; gap:.75rem;}
  .jogo-card{border-radius:.75rem; border:1px solid var(--border); background:var(--surface-2); padding:1rem; transition:transform var(--transition-smooth), box-shadow var(--transition-smooth);}
  .jogo-card:hover{transform:translateY(-3px); box-shadow:var(--shadow-glow);}
  .jogo-row{display:flex; align-items:center; justify-content:space-between; gap:.75rem;}
  .jogo-idx{font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:.05em; color:var(--muted-foreground);}
  .jogo-meta{display:flex; align-items:center; gap:.5rem;}
  .acertos-badge{border-radius:9999px; padding:.25rem .625rem; font-size:11px; font-weight:700; color:var(--on-accent);}
  .soma-txt{font-size:12px; font-variant-numeric:tabular-nums; color:var(--muted-foreground);}
  .balls{margin-top:.75rem; display:flex; flex-wrap:wrap; gap:.375rem;}
  .ball{display:inline-flex; align-items:center; justify-content:center; width:2.25rem; height:2.25rem; font-size:.875rem; border-radius:9999px; font-family:"Space Grotesk"; font-weight:700; font-variant-numeric:tabular-nums; transition:transform var(--transition-smooth);}
  .ball:hover{transform:translateY(-2px);}
  .ball.off{background:var(--surface); border:1px solid var(--border);}
  @media (max-width:479px){
    .balls{gap:.3rem;}
    .ball{width:1.9rem; height:1.9rem; font-size:.75rem;}
    .jogo-card{padding:.75rem;}
  }
  @media (max-width:359px){
    .ball{width:1.7rem; height:1.7rem; font-size:.6875rem;}
  }

  footer.foot{border-top:1px solid var(--border); padding-top:1.5rem; font-size:12px; color:var(--muted-foreground);}
  .foot-credit{margin-top:1.1rem; padding-top:1.1rem; border-top:1px dashed var(--border); text-align:center;}
  .foot-credit-title{font-family:"Space Grotesk"; font-size:1.0625rem; font-weight:700; letter-spacing:-0.01em;}
  .foot-credit-title .brand-loto{color:var(--foreground);}
  .foot-credit-title .brand-pro{background-image:var(--gradient-primary); -webkit-background-clip:text; background-clip:text; color:transparent;}
  .foot-credit-title .brand-tagline{color:var(--foreground); font-weight:600;}
  .foot-credit-sub{margin-top:.4rem; font-size:12.5px; color:var(--muted-foreground);}
  .foot-credit-sub strong{color:var(--foreground); font-weight:700;}
  .foot-privado{margin-top:.65rem; padding:.6rem .75rem; border-radius:.5rem; background:rgba(239,68,68,.08); border:1px solid rgba(239,68,68,.35); font-size:12px; line-height:1.5; color:#f87171; max-width:640px; margin-left:auto; margin-right:auto;}
  .foot-privado strong{color:#f87171; font-weight:700;}

  /* ---------- toasts ---------- */
  .toast-wrap{position:fixed; bottom:1rem; right:1rem; z-index:50; display:flex; flex-direction:column; gap:.5rem; max-width:22rem;}
  .toast{border-radius:.75rem; border:1px solid var(--border); background:var(--surface); box-shadow:var(--shadow-panel); padding:.75rem 1rem; font-size:.8125rem; animation:toast-in .18s ease-out;}
  .toast.success{border-color:rgba(16,185,129,0.4);}
  .toast.error{border-color:rgba(239,68,68,0.4);}
  .toast-title{font-weight:700;}
  .toast-desc{margin-top:.125rem; color:var(--muted-foreground);}
  @keyframes toast-in{from{opacity:0; transform:translateY(8px);} to{opacity:1; transform:translateY(0);}}

  .spin{animation:spin 1s linear infinite;}
  @keyframes spin{to{transform:rotate(360deg);}}

  /* ---------- cascata lotofácil ---------- */
  .trilha{display:flex; flex-wrap:wrap; align-items:center; gap:.5rem; margin-top:.75rem;}
  .trilha-etapa{display:flex; flex-direction:column; align-items:center; gap:.375rem; border-radius:.625rem; border:1px solid var(--border); background:var(--surface-2); padding:.5rem .75rem; min-width:4.25rem;}
  .trilha-etapa .n{font-family:"Space Grotesk"; font-size:1.125rem; font-weight:700;}
  .trilha-etapa .l{font-size:10px; text-transform:uppercase; letter-spacing:.06em; color:var(--muted-foreground);}
  .trilha-seta{color:var(--muted-foreground); flex-shrink:0;}
  .cascata-card{border-radius:.75rem; border:1px solid var(--border); background:var(--surface-2); padding:1rem; transition:transform var(--transition-smooth), box-shadow var(--transition-smooth);}
  .cascata-card:hover{transform:translateY(-3px); box-shadow:var(--shadow-glow);}

  /* ---------- cascata lotofácil: tabela de jogos ---------- */
  .cascata-table-wrap{margin-top:1rem; border-radius:.75rem; border:1px solid var(--border); overflow:auto; max-height:34rem;}
  table.cascata-table{width:100%; border-collapse:collapse; font-size:.8125rem;}
  table.cascata-table thead th{position:sticky; top:0; z-index:1; background:var(--surface-2); color:var(--muted-foreground); font-weight:600; font-size:11px; text-transform:uppercase; letter-spacing:.05em; text-align:center; padding:.55rem .4rem; border-bottom:1px solid var(--border); white-space:nowrap;}
  table.cascata-table thead th:first-child{text-align:left; padding-left:.75rem;}
