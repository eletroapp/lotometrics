function atualizarDesdobParams(){
  const c = desdobConf();
  const faixa = DESDOB_TAMANHO[state.desdobramento.loteria];
  const n = state.desdobramento.selecionadas.length;
  const tamanhoInput = document.getElementById("desdobTamanho");

  tamanhoInput.min = faixa.min;
  tamanhoInput.max = faixa.max;
  if(faixa.min === faixa.max){
    tamanhoInput.value = faixa.min;
    tamanhoInput.disabled = true;
  } else {
    tamanhoInput.disabled = false;
    const maxPossivel = Math.min(faixa.max, Math.max(faixa.min, n - 1));
    if(parseInt(tamanhoInput.value, 10) > maxPossivel) tamanhoInput.value = maxPossivel;
    if(parseInt(tamanhoInput.value, 10) < faixa.min) tamanhoInput.value = faixa.min;
  }
  state.desdobramento.tamanho = parseInt(tamanhoInput.value, 10) || faixa.min;
  document.getElementById("desdobStatTamanho").textContent = String(state.desdobramento.tamanho);

  const hint = document.getElementById("desdobTamanhoHint");
  hint.textContent = faixa.min === faixa.max
    ? `${c.nome} tem tamanho de jogo fixo: ${faixa.min} dezenas.`
    : `Aceita de ${faixa.min} a ${faixa.max} dezenas por jogo nessa modalidade. Escolha mais dezenas do que o tamanho do jogo.`;

  document.getElementById("btnGerarDesdobramento").disabled = n <= state.desdobramento.tamanho;
}

