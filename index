  { id: "fPar", g: "filtro", t: "Ímpares e pares na faixa típica", d: "A quantidade de ímpares fica na faixa central da hipergeométrica." },
  { id: "fPrimos", g: "filtro", t: "Primos na faixa típica", d: "A quantidade de primos fica na faixa central da hipergeométrica." },
  { id: "fFib", g: "filtro", t: "Fibonacci na faixa típica", d: "A quantidade de números de Fibonacci fica na faixa central." },
  { id: "fCons", g: "filtro", t: "Sequências curtas", d: "A maior sequência de dezenas seguidas não passa do limite que cobre a massa escolhida das combinações." },
  { id: "fRep", g: "filtro", t: "Repetidas do último sorteio na faixa típica", d: "A quantidade de dezenas do último sorteio presentes no jogo fica na faixa central." },
  { id: "fGrupos", g: "filtro", t: "Equilíbrio no volante", d: "Cada grupo do primeiro agrupamento do volante recebe uma quantidade de dezenas dentro da faixa central (90%)." },
];

function anFaixasJogo(R, n, massa){
  const c = R.conf, N = R.N, U = R.U, k = R.k;
  const Kodd = U.filter(x => x % 2 === 1).length, Kpri = U.filter(anIsPrimo).length, Kfib = anFibonacci(U).length;
  const F = {};
  F.soma = anFaixaTipica(anSomaPMF(U, n).probs, massa);
  F.par = anFaixaTipica(anHyper(N, Kodd, n), massa);
  F.primos = anFaixaTipica(anHyper(N, Kpri, n), massa);
  F.fib = anFaixaTipica(anHyper(N, Kfib, n), massa);
  let L = 1; while(L < n && anMaxRunCDF(N, n, L) < massa - 1e-12) L++;
  F.cons = { L: L };
  F.rep = anFaixaTipica(anHyper(N, k, n), massa);
  const P0 = anParticoes(c)[0];
  F.gTit = P0.titulo;
  F.grupos = P0.grupos.map(g => anFaixaTipica(anHyper(N, g.membros.length, n), 0.9));
  return F;
}
function anTxtFaixa(id, F){
  switch(id){
    case "fSoma": return "soma " + F.soma.a + " a " + F.soma.b;
    case "fPar": return F.par.a + " a " + F.par.b + " ímpares";
    case "fPrimos": return F.primos.a + " a " + F.primos.b + " primos";
    case "fFib": return F.fib.a + " a " + F.fib.b + " de Fibonacci";
    case "fCons": return "no máx. " + F.cons.L + " seguidas";
    case "fRep": return F.rep.a + " a " + F.rep.b + " repetidas";
    case "fGrupos": return F.gTit.toLowerCase();
  }
  return "";
}

function anGerar(){
  const a = state.analise, R = a.res;
  if(!R) return;
  const c = R.conf, N = R.N, U = R.U, min = c.minNumero;
  const tam = DESDOB_TAMANHO[c.key];
  let n = parseInt(a.tamJogo, 10) || c.dezenasPorJogo; n = Math.max(tam.min, Math.min(tam.max, n));
  const inpQ = document.getElementById("anQtd");
  let qtd = parseInt(inpQ ? inpQ.value : a.qtdJogos, 10) || 10; qtd = Math.max(1, Math.min(1000, qtd));
  a.qtdJogos = qtd; a.tamJogo = n;
  const cr = a.crit, F = anFaixasJogo(R, n, a.faixa);
  const oddM = anMascara(U, U.filter(x => x % 2 === 1)), priM = anMascara(U, U.filter(anIsPrimo)), fibM = anMascara(U, anFibonacci(U));
  const P0 = anParticoes(c)[0], gidx = new Int16Array(N); P0.grupos.forEach((g, gi) => g.membros.forEach(x => { gidx[x - min] = gi; }));
  const ult = new Set(R.ultimo);
  const w = new Array(N).fill(1);
  R.freq.forEach((r, i) => {
    if(cr.pesoFreq) w[i] *= Math.min(2, Math.max(0.5, r.f / R.E));
    if(cr.pesoAtraso) w[i] *= Math.min(3, Math.max(0.5, 0.5 + 0.5 * r.atual / R.gapEsp));
    if(cr.pesoRec) w[i] *= Math.min(2, Math.max(0.5, (r.rec + 1) / (R.Er + 1)));
  });
  const aceita = jogo => {
    let soma = 0, odd = 0, pri = 0, fib = 0, rep = 0, run = 1, best = 1;
    const gc = new Array(P0.grupos.length).fill(0);
    for(let i = 0; i < jogo.length; i++){
      const x = jogo[i], j = x - min;
      soma += x; odd += oddM[j]; pri += priM[j]; fib += fibM[j]; if(ult.has(x)) rep++; gc[gidx[j]]++;
      if(i > 0){ if(x === jogo[i-1] + 1){ run++; if(run > best) best = run; } else run = 1; }
    }
    if(cr.fSoma && (soma < F.soma.a || soma > F.soma.b)) return false;
    if(cr.fPar && (odd < F.par.a || odd > F.par.b)) return false;
    if(cr.fPrimos && (pri < F.primos.a || pri > F.primos.b)) return false;
    if(cr.fFib && (fib < F.fib.a || fib > F.fib.b)) return false;
    if(cr.fCons && best > F.cons.L) return false;
    if(cr.fRep && (rep < F.rep.a || rep > F.rep.b)) return false;
    if(cr.fGrupos){ for(let g = 0; g < gc.length; g++) if(gc[g] < F.grupos[g].a || gc[g] > F.grupos[g].b) return false; }
    return true;
  };
  const t0 = Date.now(), jogos = [], vistos = new Set(); let tentativas = 0, parou = false;
  while(jogos.length < qtd){
    if(tentativas > 400000 || Date.now() - t0 > 7000){ parou = true; break; }
    tentativas++;
    const idx = new Array(N); for(let i = 0; i < N; i++) idx[i] = i;
    const key = idx.map(i => Math.pow(Math.random(), 1 / w[i]));
    idx.sort((x, y) => key[y] - key[x]);
    const jogo = idx.slice(0, n).map(i => U[i]).sort((x, y) => x - y);
    if(!aceita(jogo)) continue;
    const sig = jogo.join(",");
    if(vistos.has(sig)) continue;
    vistos.add(sig); jogos.push(jogo);
  }
  a.jogos = jogos; a.mostrar = 100; a.info = { tentativas: tentativas, n: n, parou: parou, qtd: qtd };
  document.getElementById("btnCopiar").disabled = jogos.length === 0;
  document.getElementById("btnPdf").disabled = jogos.length === 0;
  anRender();
  if(parou && jogos.length < qtd) toast("error", "Só consegui " + jogos.length + " de " + qtd + " jogos", "Os filtros marcados deixam poucas combinações únicas — relaxe algum filtro ou aumente a faixa típica.");
  else toast("success", jogos.length + " jogo(s) gerado(s)", "A partir das análises · " + c.nome);
}

function anTabJogos(R, a){
  const c = R.conf, tam = DESDOB_TAMANHO[c.key], n = a.tamJogo || c.dezenasPorJogo;
