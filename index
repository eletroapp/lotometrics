        toast("error", "Leitor de PDF indisponível", "Importe um arquivo .txt (ex.: o que o botão Copiar gera) ou cole os jogos manualmente.");
        return;
      }
      const buffer = await file.arrayBuffer();
      const pdf = await pdfjsLib.getDocument({ data: buffer }).promise;
      const linhas = [];
      for(let p = 1; p <= pdf.numPages; p++){
        const page = await pdf.getPage(p);
        const content = await page.getTextContent();
        let linhaAtual = "";
        let ultimoY = null;
        content.items.forEach(item => {
          const y = item.transform[5];
          if(ultimoY !== null && Math.abs(y - ultimoY) > 2){
            linhas.push(linhaAtual);
            linhaAtual = "";
          }
          linhaAtual += " " + item.str;
          ultimoY = y;
        });
        if(linhaAtual) linhas.push(linhaAtual);
      }
      texto = linhas.join("\n");
    } else {
      texto = await file.text();
    }
    const textarea = document.getElementById("conferidorTexto");
    textarea.value = textarea.value ? (textarea.value + "\n" + texto) : texto;
    toast("success", "Arquivo carregado", 'Revise o texto e clique em "Adicionar à lista".');
  } catch(err){
    toast("error", "Não foi possível ler o arquivo", "Tente colar os jogos manualmente no campo de texto.");
  } finally {
    e.target.value = "";
  }
});

