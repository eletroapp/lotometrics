function formatarMoeda(valor){
  if(valor == null || isNaN(valor)) return "—";
  if(valor >= 1e6) return "R$ " + (valor/1e6).toFixed(1) + " Mi";
  if(valor >= 1e3) return "R$ " + (valor/1e3).toFixed(0) + " mil";
  return "R$ " + valor.toFixed(2).replace(".", ",");
}

function formatarMoedaExata(valor){
  if(valor == null || isNaN(valor)) return "—";
  return valor.toLocaleString("pt-BR", { style:"currency", currency:"BRL", minimumFractionDigits:2, maximumFractionDigits:2 });
}

/* ============ Camada de acesso às APIs de resultados ============
   IMPORTANTE: o endpoint "último concurso" da Caixa
   (…/portaldeloterias/api/<loteria>) é servido por um cache de borda que
   frequentemente devolve o concurso ANTERIOR (fica 1 sorteio atrasado).
   Por isso não basta chamá-lo: precisamos avançar pedindo os concursos
   seguintes por número explícito (que não são cacheados) e também comparar
   com a API espelho, ficando sempre com o concurso mais recente. */
const API_CAIXA = "https://servicebus2.caixa.gov.br/portaldeloterias/api";
const API_ESPELHO = "https://loteriascaixa-api.herokuapp.com/api";

function payloadValido(d){
  if(!d || typeof d !== "object") return false;
  if(d.exceptionMessage || d.errorMessage) return false;
  const dz = d.listaDezenas ?? d.dezenas ?? d.listaDezenasSegundoSorteio ?? d.dezenas2;
  return Array.isArray(dz) && dz.length > 0;
}

async function fetchJsonLoteria(url){
  try {
    const r = await fetch(url, { cache: "no-store" });
    if(!r.ok) return null;
    const d = await r.json();
    return payloadValido(d) ? d : null;
  } catch (e) {
    return null;
  }
}

function numeroDoPayload(d){
  const n = Number(d?.numero ?? d?.concurso);
  return isNaN(n) ? -1 : n;
}

/* Busca o payload de um concurso. Sem número => último concurso REAL. */
async function buscarPayloadConcurso(conf, numero){
  const ep = conf.apiEndpoint;
  const num = (numero == null ? "" : String(numero)).trim();
  const cb = () => `?_=${Date.now()}${Math.random().toString(36).slice(2)}`;

  if(num){
    return await fetchJsonLoteria(`${API_CAIXA}/${ep}/${num}${cb()}`)
        ?? await fetchJsonLoteria(`${API_ESPELHO}/${ep}/${num}`);
  }

  let melhor = await fetchJsonLoteria(`${API_CAIXA}/${ep}${cb()}`);

  // Avança sobre o cache desatualizado: tenta os concursos seguintes por número.
  let proximo = melhor ? (Number(melhor.numeroConcursoProximo) || numeroDoPayload(melhor) + 1) : null;
  for(let i = 0; i < 4 && proximo > 0; i++){
    const d = await fetchJsonLoteria(`${API_CAIXA}/${ep}/${proximo}${cb()}`);
    if(!d) break;
    melhor = d;
    proximo = Number(d.numeroConcursoProximo) || numeroDoPayload(d) + 1;
  }

  // Compara com a API espelho e mantém o concurso mais recente.
  const espelho = await fetchJsonLoteria(`${API_ESPELHO}/${ep}/latest`);
  if(espelho && numeroDoPayload(espelho) > numeroDoPayload(melhor)) melhor = espelho;

  return melhor;
}

async function buscarStatusConcurso(conf){
  const data = await buscarPayloadConcurso(conf, null);
  if(!data) return null;
  const valor = data.valorEstimadoProximoConcurso ?? data.valorAcumuladoProximoConcurso ?? null;
  const numeroProximo = data.numeroConcursoProximo ?? (data.numero != null ? data.numero + 1 : null);
  const numeroAtual = data.numero ?? data.concurso ?? null;
  const acumulou = data.acumulado === true;
  const dataProximo = data.dataProximoConcurso ?? null;

  // Faixas de premiação do último concurso (ganhadores + valor por ganhador)
  const faixas = data.listaRateioPremio ?? data.premiacoes ?? [];
  function montarFaixa(item){
    if(!item) return null;
    return {
      descricao: item.descricaoFaixa ?? item.descricao ?? "Faixa principal",
      ganhadores: Number(item.numeroDeGanhadores ?? item.ganhadores ?? 0) || 0,
      valorPorGanhador: item.valorPremio ?? null,
    };
  }
  const faixa = Array.isArray(faixas) && faixas.length ? montarFaixa(faixas[0]) : null;
  const segundaFaixa = Array.isArray(faixas) && faixas.length > 1 ? montarFaixa(faixas[1]) : null;
  const ganhadoresPrincipal = faixa ? faixa.ganhadores : null;
  return { valor, numeroProximo, numeroAtual, acumulou, faixa, segundaFaixa, ganhadoresPrincipal, dataProximo };
}

