    let y = pdfEscreverLinha(doc, `Dezenas escolhidas (${d.selecionadas.length}): ${[...d.selecionadas].sort((a,b)=>a-b).map(pad).join(" ")}`, 14, 31, { indent: 0 });
    y += 6;
    d.jogos.forEach((jogo, i) => {
      y = pdfEscreverLinha(doc, `Jogo ${pad(i+1)}:  ${jogo.map(pad).join("  ")}`, 14, y, { indent: 22 });
