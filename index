<script>
(function(){
  // Hash da senha de acesso (SHA-256). Não é a senha em si, só a "impressão digital" dela.
  var ACCESS_HASH = "61b1aca94ff7e855a0521ba9ca8994249c64b6639251bbefc592ae3e3916d31c";
  var STORAGE_KEY = "lotometrics_unlocked_v2";

  var lockScreen = document.getElementById('lockScreen');
  var appRoot = document.getElementById('appRoot');
  var form = document.getElementById('lockForm');
  var pwdInput = document.getElementById('lockPwd');
  var err = document.getElementById('lockErr');
  var btn = document.getElementById('lockBtn');

  // Dificultadores de acesso ao código via teclado/menu (dissuasão apenas — não é segurança real).
  document.addEventListener('contextmenu', function(e){ e.preventDefault(); });
  document.addEventListener('keydown', function(e){
    var k = e.key;
    var combo = (e.ctrlKey || e.metaKey) && e.shiftKey && (k === 'I' || k === 'i' || k === 'J' || k === 'j' || k === 'C' || k === 'c');
    var fonte = (e.ctrlKey || e.metaKey) && (k === 'U' || k === 'u');
    if (k === 'F12' || combo || fonte){ e.preventDefault(); }
  });

  async function sha256Hex(str){
    var enc = new TextEncoder().encode(str);
    var buf = await crypto.subtle.digest('SHA-256', enc);
    return Array.from(new Uint8Array(buf)).map(function(b){ return b.toString(16).padStart(2,'0'); }).join('');
  }

  function unlockApp(){
    lockScreen.style.display = 'none';
    appRoot.style.display = 'block';
  }

  // Se já foi desbloqueado antes neste navegador, entra direto sem pedir senha de novo.
  try {
    if (window.localStorage && localStorage.getItem(STORAGE_KEY) === '1'){
      unlockApp();
    }
  } catch(e){ /* localStorage indisponível (modo privado etc.) - segue pedindo senha */ }

  if (!window.crypto || !window.crypto.subtle){
    err.textContent = 'Seu navegador não tem suporte a criptografia (Web Crypto API). Use um navegador atualizado (Chrome, Edge ou Firefox).';
    err.style.display = 'block';
  }

  form.addEventListener('submit', async function(e){
    e.preventDefault();
    err.style.display = 'none';
    var pwd = pwdInput.value;
    btn.disabled = true; btn.textContent = 'Verificando...';
    try {
      var hash = await sha256Hex(pwd);
      if (hash === ACCESS_HASH){
        try { if (window.localStorage) localStorage.setItem(STORAGE_KEY, '1'); } catch(e2){}
        unlockApp();
      } else {
        err.textContent = 'Senha incorreta. Tente novamente.';
        err.style.display = 'block';
        btn.disabled = false; btn.textContent = 'Entrar';
      }
    } catch(e3){
      err.textContent = 'Erro ao verificar a senha. Tente novamente.';
      err.style.display = 'block';
      btn.disabled = false; btn.textContent = 'Entrar';
    }
  });
})();
</script>
