/* ================= ABA ANÁLISE ================= */
/* ============ Análise estatística — matemática exata ============ */
const AN_LNF = (function(){ const t = [0]; for(let i = 1; i <= 4000; i++) t[i] = t[i-1] + Math.log(i); return t; })();
function anLnC(n, r){ if(r < 0 || r > n) return -Infinity; return AN_LNF[n] - AN_LNF[r] - AN_LNF[n-r]; }
function anC(n, r){ if(r < 0 || r > n) return 0; return Math.exp(anLnC(n, r)); }
function anCBig(n, r){
  if(r < 0 || r > n) return 0n;
  r = Math.min(r, n - r);
  let x = 1n;
  for(let i = 1; i <= r; i++){ x = x * BigInt(n - r + i) / BigInt(i); }
  return x;
}
function anFmtBig(b){ return b.toLocaleString("pt-BR"); }

/* Hipergeométrica: X = nº de "marcados" (K de N) numa amostra de n. Retorna P(X=x), x = 0..min(K,n). */
function anHyper(N, K, n){
  const out = new Array(Math.min(K, n) + 1).fill(0);
  const den = anLnC(N, n);
  for(let x = 0; x < out.length; x++){
    if(n - x > N - K) continue;
    out[x] = Math.exp(anLnC(K, x) + anLnC(N - K, n - x) - den);
  }
  return out;
}

function anLnGamma(z){
  const c = [76.18009172947146, -86.50532032941677, 24.01409824083091, -1.231739572450155, 0.1208650973866179e-2, -0.5395239384953e-5];
  let x = z, y = z, tmp = x + 5.5;
  tmp -= (x + 0.5) * Math.log(tmp);
  let ser = 1.000000000190015;
  for(let j = 0; j < 6; j++) ser += c[j] / ++y;
  return -tmp + Math.log(2.5066282746310005 * ser / x);
}
/* Gama incompleta regularizada superior Q(a,x) */
function anGammaQ(a, x){
  if(x <= 0) return 1;
  const gln = anLnGamma(a);
  if(x < a + 1){
    let ap = a, sum = 1 / a, del = sum;
    for(let n = 0; n < 2000; n++){ ap++; del *= x / ap; sum += del; if(Math.abs(del) < Math.abs(sum) * 1e-15) break; }
    return Math.max(0, 1 - sum * Math.exp(-x + a * Math.log(x) - gln));
  }
  let b = x + 1 - a, c = 1 / 1e-300, d = 1 / b, h = d;
  for(let i = 1; i < 2000; i++){
    const an = -i * (i - a);
    b += 2;
    d = an * d + b; if(Math.abs(d) < 1e-300) d = 1e-300;
    c = b + an / c; if(Math.abs(c) < 1e-300) c = 1e-300;
    d = 1 / d;
    const del = d * c; h *= del;
    if(Math.abs(del - 1) < 1e-15) break;
  }
  return Math.exp(-x + a * Math.log(x) - gln) * h;
}
function anChi2P(stat, df){ return df > 0 ? anGammaQ(df / 2, stat / 2) : NaN; }
function anNormP2(z){ return z === 0 ? 1 : anGammaQ(0.5, z * z / 2); }
function anNormQuantile(p){
  const a = [-3.969683028665376e+01, 2.209460984245205e+02, -2.759285104469687e+02, 1.383577518672690e+02, -3.066479806614716e+01, 2.506628277459239e+00];
  const b = [-5.447609879822406e+01, 1.615858368580409e+02, -1.556989798598866e+02, 6.680131188771972e+01, -1.328068155288572e+01];
  const c = [-7.784894002430293e-03, -3.223964580411365e-01, -2.400758277161838e+00, -2.549732539343734e+00, 4.374664141464968e+00, 2.938163982698783e+00];
  const d = [7.784695709041462e-03, 3.224671290700398e-01, 2.445134137142996e+00, 3.754408661907416e+00];
  const pl = 0.02425, ph = 1 - pl;
  let q, r;
  if(p < pl){ q = Math.sqrt(-2 * Math.log(p)); return (((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5]) / ((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1); }
  if(p > ph){ q = Math.sqrt(-2 * Math.log(1 - p)); return -(((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5]) / ((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1); }
  q = p - 0.5; r = q * q;
  return (((((a[0]*r+a[1])*r+a[2])*r+a[3])*r+a[4])*r+a[5]) * q / (((((b[0]*r+b[1])*r+b[2])*r+b[3])*r+b[4])*r+1);
}

/* Qui-quadrado de aderência com agrupamento de caselas (esperado mínimo 5). */
function anGOF(obs, probs, total, minE){
  minE = minE || 5;
  let bins = obs.map((o, i) => ({ lo: i, hi: i, o: o, e: probs[i] * total })).filter(b => b.e > 0 || b.o > 0);
  while(bins.length > 2){
    let mi = -1, me = Infinity;
    bins.forEach((b, i) => { if(b.e < minE && b.e < me){ me = b.e; mi = i; } });
    if(mi < 0) break;
    const j = mi === 0 ? 1 : (mi === bins.length - 1 ? mi - 1 : (bins[mi-1].e <= bins[mi+1].e ? mi - 1 : mi + 1));
    const a = Math.min(mi, j), b = Math.max(mi, j);
    bins.splice(a, 2, { lo: bins[a].lo, hi: bins[b].hi, o: bins[a].o + bins[b].o, e: bins[a].e + bins[b].e });
  }
  let stat = 0;
  bins.forEach(b => { stat += (b.o - b.e) * (b.o - b.e) / b.e; });
  const df = bins.length - 1;
  return { bins: bins, stat: stat, df: df, p: df > 0 ? anChi2P(stat, df) : NaN };
}

/* Faixa típica: menor intervalo contíguo, crescendo a partir da moda, com massa >= alvo. */
function anFaixaTipica(probs, massa){
  let m = 0;
  for(let i = 1; i < probs.length; i++) if(probs[i] > probs[m]) m = i;
  let a = m, b = m, acc = probs[m];
  while(acc < massa - 1e-12){
    const pa = a > 0 ? probs[a-1] : -1, pb = b < probs.length - 1 ? probs[b+1] : -1;
    if(pa < 0 && pb < 0) break;
    if(pa >= pb){ a--; acc += probs[a]; } else { b++; acc += probs[b]; }
  }
  return { a: a, b: b, massa: acc };
}
function anMassa(probs, a, b){ let s = 0; for(let i = Math.max(0, a); i <= Math.min(probs.length - 1, b); i++) s += probs[i]; return s; }

/* Distribuição EXATA da soma de n dezenas distintas sorteadas de um universo (programação dinâmica). */
const AN_SOMA_CACHE = {};
function anSomaPMF(U, n){
  const key = U[0] + "_" + U.length + "_" + n;
  if(AN_SOMA_CACHE[key]) return AN_SOMA_CACHE[key];
  const N = U.length;
  let smax = 0;
  for(let i = 0; i < n; i++) smax += U[N - 1 - i];
  const S = smax + 1;
  const dp = new Float64Array((n + 1) * S);
  dp[0] = 1;
  for(let idx = 0; idx < N; idx++){
    const v = U[idx];
    for(let j = Math.min(n, idx + 1); j >= 1; j--){
      const base = j * S, prev = (j - 1) * S;
      for(let s = smax; s >= v; s--){ const x = dp[prev + s - v]; if(x !== 0) dp[base + s] += x; }
    }
  }
  let tot = 0;
  for(let s = 0; s < S; s++) tot += dp[n * S + s];
  const probs = new Float64Array(S);
  for(let s = 0; s < S; s++) probs[s] = dp[n * S + s] / tot;
  const mediaU = U.reduce((x, y) => x + y, 0) / N;
  const varU = U.reduce((x, y) => x + (y - mediaU) * (y - mediaU), 0) / N;
  const out = { probs: probs, media: n * mediaU, dp: Math.sqrt(n * varU * (N - n) / (N - 1)) };
  AN_SOMA_CACHE[key] = out;
  return out;
}

/* Nº esperado de sorteios para todas as N dezenas aparecerem ao menos uma vez (cobertura exata, BigInt). */
function anTempoCobertura(N, k){
  const S = 10n ** 40n, Ck = anCBig(N, k);
  let soma = 0n;
  for(let j = 1; j <= N; j++){
    const q = (N - j >= k) ? anCBig(N - j, k) : 0n;
    const termo = anCBig(N, j) * Ck * S / (Ck - q);
    soma += (j % 2 === 1) ? termo : -termo;
  }
  return Number(soma / (10n ** 20n)) / 1e20;
}

/* Dezenas consecutivas num subconjunto de n dezenas de N (exato) */
function anAdjPMF(N, n){
  const out = [];
  const tot = anLnC(N, n);
  for(let r = 0; r <= n - 1; r++) out.push(Math.exp(anLnC(n - 1, r) + anLnC(N - n + 1, n - r) - tot));
  return out;
}
function anMaxRunCDF(N, n, L){
  const total = anC(N, n), blocos = N - n + 1;
  let cur = new Array(n + 1).fill(0); cur[0] = 1;
  let soma = 0;
  for(let b = 1; b <= n; b++){
    const nxt = new Array(n + 1).fill(0);
    for(let s = 1; s <= n; s++){ let acc = 0; for(let q = 1; q <= Math.min(L, s); q++) acc += cur[s - q]; nxt[s] = acc; }
    cur = nxt;
    soma += cur[n] * anC(blocos, b);
  }
  return Math.min(1, soma / total);
}
function anMaxRunPMF(N, n){
  const out = [0];
  let ant = 0;
  for(let L = 1; L <= n; L++){ const c = anMaxRunCDF(N, n, L); out.push(Math.max(0, c - ant)); ant = c; }
  return out;
}

function anIsPrimo(n){
  if(n < 2) return false;
  if(n < 4) return true;
  if(n % 2 === 0) return false;
  for(let i = 3; i * i <= n; i += 2) if(n % i === 0) return false;
  return true;
}
function anFibonacci(U){
  const max = U[U.length - 1], set = new Set([0, 1]);
  let a = 1, b = 1;
  while(b <= max){ set.add(b); const c = a + b; a = b; b = c; }
  return U.filter(n => set.has(n));
}


/* Cauda superior/inferior exata da binomial (contagens raras de duplas/trios) */
function anBinomCauda(T, q, f, superior){
  if(q <= 0) return superior ? (f <= 0 ? 1 : 0) : 1;
  const lq = Math.log(q), l1q = Math.log(1 - q);
  let s = 0;
  if(superior){
    for(let x = f; x <= T; x++){
      const t = Math.exp(anLnC(T, x) + x * lq + (T - x) * l1q);
      s += t;
      if(x > f + 5 && t < s * 1e-17) break;
    }
  } else {
    for(let x = f; x >= 0; x--){
      const t = Math.exp(anLnC(T, x) + x * lq + (T - x) * l1q);
      s += t;
      if(x < f - 5 && t < s * 1e-17) break;
    }
  }
  return Math.min(1, s);
}

const AN_K = { megasena: 6, lotofacil: 15, duplasena: 6, lotomania: 20, diadesorte: 7 };
const AN_MESES = ["janeiro","fevereiro","marco","abril","maio","junho","julho","agosto","setembro","outubro","novembro","dezembro"];
const AN_MESES_LABEL = ["Janeiro","Fevereiro","Março","Abril","Maio","Junho","Julho","Agosto","Setembro","Outubro","Novembro","Dezembro"];

/* Nº de grupos distintos tocados por um sorteio de k dezenas — distribuição exata (inclusão–exclusão, BigInt) */
function anOcupacaoPMF(sizes, k){
  const g = sizes.length, M = 1 << g, f = new Array(M);
  for(let m = 0; m < M; m++){ let s = 0; for(let i = 0; i < g; i++) if((m >> i) & 1) s += sizes[i]; f[m] = anCBig(s, k); }
  for(let i = 0; i < g; i++) for(let m = 0; m < M; m++) if((m >> i) & 1) f[m] -= f[m ^ (1 << i)];
  const tot = anCBig(sizes.reduce((a, b) => a + b, 0), k), out = new Array(g + 1).fill(0n);
  for(let m = 0; m < M; m++){ let pc = 0; for(let i = 0; i < g; i++) if((m >> i) & 1) pc++; out[pc] += f[m]; }
  return out.map(x => Number(x * (10n ** 15n) / tot) / 1e15);
}

function anUniverso(conf){ const u = []; for(let n = conf.minNumero; n <= conf.maxNumero; n++) u.push(n); return u; }
function anP2(n){ return String(n).padStart(2, "0"); }

function anParticoes(conf){
  const U = anUniverso(conf);
  function part(titulo, desc, keyFn, labelFn){
    const mapa = {};
    U.forEach(n => { const k = keyFn(n); (mapa[k] = mapa[k] || []).push(n); });
    const keys = Object.keys(mapa).map(Number).sort((a, b) => a - b);
    return { titulo: titulo, desc: desc, grupos: keys.map(k => ({ rotulo: labelFn(k, mapa[k]), membros: mapa[k] })) };
  }
  const termin = part("Terminações (último algarismo)", "Agrupa as dezenas pelo último dígito — equivale às colunas de um volante de 10 colunas.", n => n % 10, k => "Termina em " + k);
  switch(conf.key){
    case "megasena": return [
      part("Quadrantes do volante (6 linhas × 10 colunas)", "O volante é dividido em 4 blocos de 15 dezenas: 3 linhas × 5 colunas cada.",
        n => (Math.floor((n - 1) / 10) < 3 ? 0 : 2) + (((n - 1) % 10) < 5 ? 0 : 1),
        k => ["Q1 · superior esquerdo (01–05, 11–15, 21–25)", "Q2 · superior direito (06–10, 16–20, 26–30)", "Q3 · inferior esquerdo (31–35, 41–45, 51–55)", "Q4 · inferior direito (36–40, 46–50, 56–60)"][k]),
      part("Linhas do volante", "Seis linhas de 10 dezenas (01–10, 11–20, … 51–60).", n => Math.floor((n - 1) / 10), k => anP2(10 * k + 1) + "–" + anP2(10 * k + 10)),
      termin ];
    case "lotofacil": return [
      part("Linhas do volante (5 × 5)", "Cinco linhas de 5 dezenas (01–05, 06–10, … 21–25).", n => Math.floor((n - 1) / 5), k => "Linha " + (k + 1) + " (" + anP2(5 * k + 1) + "–" + anP2(5 * k + 5) + ")"),
      part("Colunas do volante (5 × 5)", "Cinco colunas: dezenas que diferem de 5 em 5 (01-06-11-16-21, 02-07-…).", n => (n - 1) % 5, k => "Coluna " + (k + 1)),
      part("Moldura × miolo", "Moldura = as 16 dezenas da borda do volante 5×5; miolo = as 9 dezenas centrais.",
        n => { const r = Math.floor((n - 1) / 5), c = (n - 1) % 5; return (r === 0 || r === 4 || c === 0 || c === 4) ? 0 : 1; },
        k => k === 0 ? "Moldura (16 dezenas)" : "Miolo (9 dezenas)") ];
    case "duplasena": return [
      part("Metades do universo", "Dezenas 01–25 contra 26–50.", n => n <= 25 ? 0 : 1, k => k === 0 ? "01–25" : "26–50"),
      part("Faixas de 10", "Cinco faixas de 10 dezenas (01–10 … 41–50).", n => Math.floor((n - 1) / 10), k => anP2(10 * k + 1) + "–" + anP2(10 * k + 10)),
      termin ];
    case "lotomania": return [
      part("Quadrantes do volante (10 × 10)", "O volante 00–99 dividido em 4 blocos de 25 dezenas (5 linhas × 5 colunas).",
        n => (Math.floor(n / 10) < 5 ? 0 : 2) + ((n % 10) < 5 ? 0 : 1),
        k => ["Q1 · superior esquerdo (00–04 … 40–44)", "Q2 · superior direito (05–09 … 45–49)", "Q3 · inferior esquerdo (50–54 … 90–94)", "Q4 · inferior direito (55–59 … 95–99)"][k]),
      part("Linhas do volante (dezenas)", "Dez linhas de 10 dezenas (00–09, 10–19, … 90–99).", n => Math.floor(n / 10), k => k + "0–" + k + "9"),
      part("Colunas do volante (unidades)", "Dez colunas: dezenas com o mesmo último algarismo.", n => n % 10, k => "Final " + k) ];
    case "diadesorte": return [
      part("Quinzenas do mês", "Dias 1–15 contra 16–31.", n => n <= 15 ? 0 : 1, k => k === 0 ? "Dias 1–15" : "Dias 16–31"),
      part("Semanas do mês", "Blocos de 7 dias: 1–7, 8–14, 15–21, 22–28 e 29–31.", n => Math.floor((n - 1) / 7), k => ["Dias 1–7", "Dias 8–14", "Dias 15–21", "Dias 22–28", "Dias 29–31"][k]),
      termin ];
  }
  return [];
}

function anMascara(U, lista){ const m = new Uint8Array(U.length); lista.forEach(n => { m[n - U[0]] = 1; }); return m; }

function anDistConj(seq, N, k, mask, minN){
  let K = 0; mask.forEach(v => { K += v; });
  const probs = anHyper(N, K, k);
  const obs = new Array(probs.length).fill(0);
  seq.forEach(d => { let c = 0; d.forEach(n => { if(mask[n - minN]) c++; }); obs[c]++; });
  const total = seq.length;
  const gof = anGOF(obs, probs, total);
  const mediaObs = obs.reduce((s, o, x) => s + o * x, 0) / total;
  const mediaEsp = k * K / N;
  const varEsp = k * (K / N) * (1 - K / N) * (N - k) / (N - 1);
  return { K: K, probs: probs, obs: obs, total: total, gof: gof, mediaObs: mediaObs, mediaEsp: mediaEsp, z: varEsp > 0 ? (mediaObs - mediaEsp) / Math.sqrt(varEsp / total) : 0 };
}

function anFreqChi(seqX, N, k, minN){
  const cont = new Array(N).fill(0);
  seqX.forEach(d => d.forEach(n => cont[n - minN]++));
  const E = seqX.length * k / N;
  let s = 0; cont.forEach(f => { s += (f - E) * (f - E) / E; });
  const stat = s * (N - 1) / (N - k);
  return { cont: cont, stat: stat, df: N - 1, p: anChi2P(stat, N - 1) };
}

function anAnalisar(conf, concursos, selDS){
  const N = conf.maxNumero - conf.minNumero + 1, k = AN_K[conf.key], p = k / N, min = conf.minNumero;
  const U = anUniverso(conf);
  const cron = concursos.slice().reverse();                       // do mais antigo ao mais novo
  let seq = [], series = [];
  if(conf.key === "duplasena"){
    const u1 = selDS !== "2", u2 = selDS !== "1";
    cron.forEach(c => { if(u1) seq.push(c.dezenas); if(u2) seq.push(c.dezenas2); });
    if(u1) series.push(cron.map(c => c.dezenas));
    if(u2) series.push(cron.map(c => c.dezenas2));
  } else { seq = cron.map(c => c.dezenas); series = [seq]; }
  const T = cron.length, Teff = seq.length, perC = Teff / T;
  const R = { conf: conf, N: N, k: k, p: p, U: U, T: T, Teff: Teff, perC: perC, selDS: selDS, testes: [] };
  R.periodo = { de: cron[0], ate: cron[T - 1] };
  R.ultimo = seq[Teff - 1];
  const addTeste = (nome, g) => { if(g && isFinite(g.p)) R.testes.push({ nome: nome, stat: g.stat, df: g.df, p: g.p }); };

  /* ---- Frequência, atraso e janela recente ---- */
  const cont = new Array(N).fill(0), ultimo = new Array(N).fill(-1), gapMax = new Array(N).fill(0), somaGaps = new Array(N).fill(0), nGaps = new Array(N).fill(0);
  seq.forEach((d, t) => {
    d.forEach(n => {
      const i = n - min;
      cont[i]++;
      if(ultimo[i] >= 0){ const g = t - ultimo[i] - 1; somaGaps[i] += g; nGaps[i]++; if(g > gapMax[i]) gapMax[i] = g; }
      else if(t > gapMax[i]) gapMax[i] = t;
      ultimo[i] = t;
    });
  });
  const Wd = Math.min(Teff, Math.round(10 * perC));
  const rec = new Array(N).fill(0);
  seq.slice(Teff - Wd).forEach(d => d.forEach(n => rec[n - min]++));
  const E = Teff * p, sigma = Math.sqrt(Teff * p * (1 - p)), Er = Wd * p, sr = Math.sqrt(Wd * p * (1 - p));
  R.freq = U.map((n, i) => {
    const atual = ultimo[i] >= 0 ? Teff - 1 - ultimo[i] : Teff;
    if(atual > gapMax[i]) gapMax[i] = atual;
    return { n: n, f: cont[i], pct: cont[i] / Teff, esp: E, z: sigma > 0 ? (cont[i] - E) / sigma : 0,
      atual: atual, nunca: ultimo[i] < 0, gapMax: gapMax[i], gapMed: nGaps[i] ? somaGaps[i] / nGaps[i] : null,
      pAtraso: Math.pow(1 - p, atual), rec: rec[i], zRec: sr > 0 ? (rec[i] - Er) / sr : 0 };
  });
  const chiF = anFreqChi(seq, N, k, min);
  R.chiFreq = chiF;
  R.zBonf = anNormQuantile(1 - 0.025 / N);
  R.nBonf = R.freq.filter(r => Math.abs(r.z) > R.zBonf).length;
  R.n196 = R.freq.filter(r => Math.abs(r.z) > 1.959964).length;
  R.nAtraso5 = R.freq.filter(r => r.pAtraso < 0.05).length;
  R.E = E; R.sigma = sigma; R.Wd = Wd; R.Er = Er;
  R.gapEsp = (1 - p) / p;
  addTeste("Uniformidade das dezenas (frequência)", chiF);

  /* ---- Ciclo (cobertura de todas as dezenas) ---- */
  const completos = []; let vistos = new Set(), inicio = 0;
  seq.forEach((d, t) => { d.forEach(n => vistos.add(n)); if(vistos.size === N){ completos.push(t - inicio + 1); vistos = new Set(); inicio = t + 1; } });
  R.ciclo = { completos: completos, media: completos.length ? completos.reduce((a, b) => a + b, 0) / completos.length : null,
    esperado: anTempoCobertura(N, k), atualDraws: Teff - inicio, faltam: U.filter(n => !vistos.has(n)), vistos: vistos.size };

  /* ---- Estrutura do sorteio ---- */
  const est = R.est = {};
  est.impar = anDistConj(seq, N, k, anMascara(U, U.filter(n => n % 2 === 1)), min);
  est.primos = anDistConj(seq, N, k, anMascara(U, U.filter(anIsPrimo)), min);
  est.fib = anDistConj(seq, N, k, anMascara(U, anFibonacci(U)), min);
  addTeste("Quantidade de ímpares por sorteio", est.impar.gof);
  addTeste("Quantidade de primos por sorteio", est.primos.gof);
  addTeste("Quantidade de Fibonacci por sorteio", est.fib.gof);

  // soma exata
  const somaP = anSomaPMF(U, k), sp = somaP.probs;
  const somas = seq.map(d => d.reduce((a, b) => a + b, 0));
  let first = 0; while(sp[first] === 0) first++;
  let last = sp.length - 1; while(sp[last] === 0) last--;
  const bins = []; { let acc = 0, bacc = 0, lo = first, alvo = 1;
    for(let s = first; s <= last; s++){
      acc += sp[s]; bacc += sp[s];
      if(alvo < 10 && acc >= alvo * 0.1 - 1e-12){ bins.push({ lo: lo, hi: s, prob: bacc }); lo = s + 1; bacc = 0; while(alvo < 10 && acc >= alvo * 0.1 - 1e-12) alvo++; }
    }
    if(lo <= last) bins.push({ lo: lo, hi: last, prob: bacc });
  }
  const obsBins = bins.map(() => 0);
  somas.forEach(s => { for(let i = 0; i < bins.length; i++){ if(s >= bins[i].lo && s <= bins[i].hi){ obsBins[i]++; break; } } });
  const gofSoma = anGOF(obsBins, bins.map(b => b.prob), Teff);
  const sMed = somas.reduce((a, b) => a + b, 0) / Teff;
  const sDp = Teff > 1 ? Math.sqrt(somas.reduce((a, b) => a + (b - sMed) * (b - sMed), 0) / (Teff - 1)) : 0;
  const ft = anFaixaTipica(sp, 0.8);
  est.soma = { bins: bins, obsBins: obsBins, gof: gofSoma, media: sMed, dp: sDp, min: Math.min.apply(null, somas), max: Math.max.apply(null, somas),
    mediaEsp: somaP.media, dpEsp: somaP.dp, z: (sMed - somaP.media) / (somaP.dp / Math.sqrt(Teff)),
    tip: ft, dentroTip: somas.filter(s => s >= ft.a && s <= ft.b).length / Teff, somas: somas };
  addTeste("Soma das dezenas (decis exatos)", gofSoma);

  // consecutivas
  const adjObs = new Array(k).fill(0), runObs = new Array(k + 1).fill(0);
  const infoSeq = d => { let run = 1, best = 1, adj = 0; for(let i = 1; i < d.length; i++){ if(d[i] === d[i-1] + 1){ adj++; run++; if(run > best) best = run; } else run = 1; } return { adj: adj, best: best }; };
  seq.forEach(d => { const r = infoSeq(d); adjObs[r.adj]++; runObs[r.best]++; });
  const adjP = anAdjPMF(N, k), runP = anMaxRunPMF(N, k);
  est.adj = { obs: adjObs, probs: adjP, gof: anGOF(adjObs, adjP, Teff), mediaObs: adjObs.reduce((s, o, x) => s + o * x, 0) / Teff, mediaEsp: k * (k - 1) / N };
  est.run = { obs: runObs, probs: runP, gof: anGOF(runObs, runP, Teff) };
  addTeste("Pares de dezenas consecutivas por sorteio", est.adj.gof);
  addTeste("Maior sequência de consecutivas", est.run.gof);

  // repetidas do sorteio anterior
  const repObs = new Array(k + 1).fill(0); let nPares = 0;
  series.forEach(s => { for(let t = 1; t < s.length; t++){ const prev = new Set(s[t-1]); let c = 0; s[t].forEach(n => { if(prev.has(n)) c++; }); repObs[c]++; nPares++; } });
  const repP = anHyper(N, k, k);
  est.rep = { obs: repObs, probs: repP, total: nPares, gof: nPares ? anGOF(repObs, repP, nPares) : null,
    mediaObs: nPares ? repObs.reduce((s, o, x) => s + o * x, 0) / nPares : null, mediaEsp: k * k / N };
  if(est.rep.gof) addTeste("Repetidas do sorteio anterior", est.rep.gof);

  // Lotofácil: moldura
  if(conf.key === "lotofacil"){
    const mold = U.filter(n => { const r = Math.floor((n - 1) / 5), c = (n - 1) % 5; return r === 0 || r === 4 || c === 0 || c === 4; });
    est.moldura = anDistConj(seq, N, k, anMascara(U, mold), min);
    addTeste("Dezenas da moldura por sorteio", est.moldura.gof);
  }

  /* ---- Filtros do app × realidade ---- */
  const nj = conf.dezenasPorJogo, fl = [];
  const mesmoTam = nj === k;
  const oddMask = anMascara(U, U.filter(n => n % 2 === 1));
  const Kodd = U.filter(n => n % 2 === 1).length;
  const somaJ = anSomaPMF(U, nj).probs;
  const passaSoma = d => { const s = d.reduce((a, b) => a + b, 0); return s >= conf.somaMin && s <= conf.somaMax; };
  const passaCons = d => infoSeq(d).best <= conf.maxConsecutivos;
  const oddCount = d => { let c = 0; d.forEach(n => { if(oddMask[n - min]) c++; }); return c; };
  const passaImpar = d => { const c = oddCount(d); return c >= conf.imparesMin && c <= conf.imparesMax; };
  const repHyp = anHyper(N, k, nj);
  const repOk = c => conf.sorteadosAnteriorMin != null ? (c >= conf.sorteadosAnteriorMin && c <= conf.sorteadosAnteriorMax) : (c <= conf.maxRepetidosAnterior);
  const repTeor = (() => { let s = 0; repHyp.forEach((pr, c) => { if(repOk(c)) s += pr; }); return s; })();
  const share = (arr, fn) => arr.length ? arr.filter(fn).length / arr.length : null;
  if(conf.somaMin != null) fl.push({ nome: "Soma entre " + conf.somaMin + " e " + conf.somaMax, teor: anMassa(somaJ, conf.somaMin, conf.somaMax), obs: mesmoTam ? share(seq, passaSoma) : null });
  if(conf.maxConsecutivos) fl.push({ nome: "No máximo " + conf.maxConsecutivos + " dezenas consecutivas seguidas", teor: anMaxRunCDF(N, nj, conf.maxConsecutivos), obs: mesmoTam ? share(seq, passaCons) : null });
  if(conf.imparesMin != null){
    const hy = anHyper(N, Kodd, nj); let s = 0; hy.forEach((pr, c) => { if(c >= conf.imparesMin && c <= conf.imparesMax) s += pr; });
    fl.push({ nome: "Entre " + conf.imparesMin + " e " + conf.imparesMax + " ímpares", teor: s, obs: mesmoTam ? share(seq, passaImpar) : null });
  }
  if(conf.maxRepetidosAnterior != null || conf.sorteadosAnteriorMin != null){
    const pares = [];
    series.forEach(s => { for(let t = 1; t < s.length; t++){ const prev = new Set(s[t-1]); let c = 0; s[t].forEach(n => { if(prev.has(n)) c++; }); pares.push(c); } });
    fl.push({ nome: conf.sorteadosAnteriorMin != null ? "Entre " + conf.sorteadosAnteriorMin + " e " + conf.sorteadosAnteriorMax + " repetidas do sorteio anterior" : "No máximo " + conf.maxRepetidosAnterior + " repetidas do sorteio anterior",
      teor: repTeor, obs: mesmoTam ? share(pares, repOk) : null });
  }
  let conjunto = null;
  if(mesmoTam){ let ok = 0, tot = 0;
    series.forEach(s => { for(let t = 1; t < s.length; t++){ tot++; const d = s[t]; let pass = true;
      if(conf.somaMin != null && !passaSoma(d)) pass = false;
      if(pass && conf.maxConsecutivos && !passaCons(d)) pass = false;
      if(pass && conf.imparesMin != null && !passaImpar(d)) pass = false;
      if(pass && (conf.maxRepetidosAnterior != null || conf.sorteadosAnteriorMin != null)){ const prev = new Set(s[t-1]); let c = 0; d.forEach(n => { if(prev.has(n)) c++; }); if(!repOk(c)) pass = false; }
      if(pass) ok++; } });
    conjunto = tot ? ok / tot : null; }
  R.filtros = { itens: fl, conjunto: conjunto, nj: nj, mesmoTam: mesmoTam };

  /* ---- Grupos do volante ---- */
  R.grupos = anParticoes(conf).map(P => {
    const sizes = P.grupos.map(g => g.membros.length);
    const idx = new Int16Array(N); P.grupos.forEach((g, gi) => g.membros.forEach(n => { idx[n - min] = gi; }));
    const tot = new Array(sizes.length).fill(0); seq.forEach(d => d.forEach(n => tot[idx[n - min]]++));
    const linhas = P.grupos.map((g, gi) => { const pi = sizes[gi] / N, Eg = Teff * k * pi, v = Teff * k * pi * (1 - pi) * (N - k) / (N - 1);
      return { rotulo: g.rotulo, tam: sizes[gi], obs: tot[gi], esp: Eg, mediaObs: tot[gi] / Teff, mediaEsp: k * pi, z: (tot[gi] - Eg) / Math.sqrt(v) }; });
    let pear = 0; linhas.forEach(l => { pear += (l.obs - l.esp) * (l.obs - l.esp) / l.esp; });
    const stat = pear * (N - 1) / (N - k), df = linhas.length - 1;
    const res = { titulo: P.titulo, desc: P.desc, linhas: linhas, stat: stat, df: df, p: anChi2P(stat, df) };
    addTeste("Volante — " + P.titulo, res);
    const gN = sizes.length, oprobs = anOcupacaoPMF(sizes, k), oobs = new Array(gN + 1).fill(0);
    seq.forEach(d => { const t = new Set(); d.forEach(n => t.add(idx[n - min])); oobs[t.size]++; });
    res.occ = { obs: oobs, probs: oprobs, gof: anGOF(oobs, oprobs, Teff), mediaObs: oobs.reduce((a, o, x) => a + o * x, 0) / Teff, mediaEsp: oprobs.reduce((a, pr, x) => a + pr * x, 0) };
    addTeste("Volante — dispersão em " + P.titulo, res.occ.gof);
    return res;
  });

  /* ---- Duplas e trios ---- */
  const c2 = new Uint16Array(N * N);
  seq.forEach(d => { for(let i = 0; i < d.length; i++) for(let j = i + 1; j < d.length; j++) c2[(d[i] - min) * N + (d[j] - min)]++; });
  const q2 = k * (k - 1) / (N * (N - 1)), M2 = N * (N - 1) / 2, lista2 = [];
  for(let a = 0; a < N; a++) for(let b = a + 1; b < N; b++) lista2.push({ a: U[a], b: U[b], f: c2[a * N + b] });
  lista2.sort((x, y) => y.f - x.f || x.a - y.a || x.b - y.b);
  const mk2 = (it, sup) => ({ itens: [it.a, it.b], f: it.f, esp: Teff * q2, pAdj: Math.min(1, M2 * anBinomCauda(Teff, q2, it.f, sup)) });
  R.duplas = { M: M2, q: q2, esp: Teff * q2, top: lista2.slice(0, 10).map(it => mk2(it, true)), baixo: lista2.slice(-10).reverse().map(it => mk2(it, false)) };
  const c3 = new Uint16Array(N * N * N);
  seq.forEach(d => { const L = d.length; for(let i = 0; i < L; i++) for(let j = i + 1; j < L; j++) for(let l = j + 1; l < L; l++) c3[((d[i] - min) * N + (d[j] - min)) * N + (d[l] - min)]++; });
  const q3 = k * (k - 1) * (k - 2) / (N * (N - 1) * (N - 2)), M3 = N * (N - 1) * (N - 2) / 6, lista3 = [];
  for(let a = 0; a < N; a++) for(let b = a + 1; b < N; b++) for(let c = b + 1; c < N; c++){ const f = c3[(a * N + b) * N + c]; if(f > 0) lista3.push({ a: U[a], b: U[b], c: U[c], f: f }); }
  lista3.sort((x, y) => y.f - x.f || x.a - y.a || x.b - y.b || x.c - y.c);
  R.trios = { M: M3, q: q3, esp: Teff * q3, top: lista3.slice(0, 10).map(it => ({ itens: [it.a, it.b, it.c], f: it.f, esp: Teff * q3, pAdj: Math.min(1, M3 * anBinomCauda(Teff, q3, it.f, true)) })) };

  /* ---- Específicas ---- */
  R.esp = {};
  if(conf.key === "duplasena"){
    const ov = new Array(k + 1).fill(0);
    cron.forEach(c => { const s1 = new Set(c.dezenas); let x = 0; c.dezenas2.forEach(n => { if(s1.has(n)) x++; }); ov[x]++; });
    const pr = anHyper(N, k, k), g = anGOF(ov, pr, T);
    const f1 = anFreqChi(cron.map(c => c.dezenas), N, k, min), f2 = anFreqChi(cron.map(c => c.dezenas2), N, k, min);
    R.esp.ds = { ov: ov, probs: pr, gof: g, mediaObs: ov.reduce((s, o, x) => s + o * x, 0) / T, mediaEsp: k * k / N, f1: f1, f2: f2 };
    addTeste("1º × 2º sorteio — dezenas em comum", g);
    addTeste("Uniformidade — somente 1º sorteio", f1);
    addTeste("Uniformidade — somente 2º sorteio", f2);
  }
  if(conf.key === "diadesorte"){
    const cm = new Array(12).fill(0); let tm = 0;
    cron.forEach(c => { if(c.mes >= 1 && c.mes <= 12){ cm[c.mes - 1]++; tm++; } });
    if(tm > 0){
      const g = anGOF(cm, new Array(12).fill(1 / 12), tm);
      R.esp.mes = { cont: cm, total: tm, gof: g };
      addTeste("Mês de Sorte (12 meses)", g);
    } else R.esp.mes = null;
  }
  return R;
}


/* ============ Busca dos concursos ============ */
function anMesDeSorte(v){
  if(v == null) return null;
  const s = String(v).normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim().toLowerCase();
  if(/^\d+$/.test(s)){ const n = parseInt(s, 10); return n >= 1 && n <= 12 ? n : null; }
  const i = AN_MESES.indexOf(s);
  return i >= 0 ? i + 1 : null;
}
function anNormalizar(conf, d){
  const nums = arr => (arr || []).map(x => parseInt(String(x), 10)).filter(n => !isNaN(n));
  const k = AN_K[conf.key];
  const ok = arr => arr.length === k && new Set(arr).size === k && arr.every(n => n >= conf.minNumero && n <= conf.maxNumero);
  const dz = nums(d.listaDezenas ?? d.dezenas);
  if(!ok(dz)) return null;
  let dz2 = [];
  if(conf.key === "duplasena"){
    dz2 = nums(d.listaDezenasSegundoSorteio ?? d.dezenas2);
    if(!ok(dz2)) return null;
  }
  return {
    numero: numeroDoPayload(d), data: d.dataApuracao ?? d.data ?? "",
    dezenas: dz.sort((a, b) => a - b), dezenas2: dz2.sort((a, b) => a - b),
    mes: conf.key === "diadesorte" ? anMesDeSorte(d.nomeTimeCoracaoMesSorte ?? d.mesSorte ?? d.mes) : null,
  };
}

async function anCarregar(forcar){
  const a = state.analise, conf = LOTERIAS[a.loteria];
  if(!conf) return;
  const token = ++a.token;
  a.carregando = true; a.erro = null; a.res = null; a.jogos = [];
  anRender();
  try {
    let cache = a.cache[conf.key];
    if(forcar || !cache){ cache = a.cache[conf.key] = { ultimo: null, mapa: new Map() }; }
    if(cache.ultimo == null){
      const latest = await buscarPayloadConcurso(conf, null);
      if(token !== a.token) return;
      if(!latest) throw new Error("Não foi possível obter os resultados oficiais agora. Verifique a conexão e tente novamente.");
      cache.ultimo = numeroDoPayload(latest);
      cache.mapa.set(cache.ultimo, anNormalizar(conf, latest));
    }
    const alvo = Math.min(a.qtd, cache.ultimo);
    const faltam = [];
    for(let n = cache.ultimo; n > cache.ultimo - alvo; n--) if(!cache.mapa.get(n)) faltam.push(n);
    a.progresso = { atual: alvo - faltam.length, total: alvo };
    anAtualizarProgresso();
    let idx = 0;
    const worker = async () => {
      while(idx < faltam.length && token === a.token){
        const n = faltam[idx++];
        let d = await buscarPayloadConcurso(conf, n);
        if(!d) d = await buscarPayloadConcurso(conf, n);
        cache.mapa.set(n, d ? anNormalizar(conf, d) : null);
        a.progresso.atual++;
        anAtualizarProgresso();
      }
    };
    await Promise.all(Array.from({ length: Math.min(6, faltam.length) }, worker));
    if(token !== a.token) return;
    const lista = [];
    for(let n = cache.ultimo; n > cache.ultimo - alvo; n--){ const c = cache.mapa.get(n); if(c) lista.push(c); }
    a.falhas = alvo - lista.length;
    if(lista.length < 20) throw new Error("Só consegui carregar " + lista.length + " concursos dessa modalidade. Tente novamente em instantes.");
    await new Promise(r => setTimeout(r, 15));
    a.dados = lista;
    a.res = anAnalisar(conf, lista, a.selDS);
    toast("success", lista.length + " concursos analisados", conf.nome + (a.falhas ? " · " + a.falhas + " não carregaram" : ""));
  } catch(e){
    if(token === a.token) a.erro = e.message || "Erro ao carregar os concursos para análise.";
  } finally {
    if(token === a.token){ a.carregando = false; anRender(); }
  }
}
function anAtualizarProgresso(){
  const f = document.getElementById("anProgFill"), l = document.getElementById("anProgLabel");
  if(!f || !l) return;
  const { atual, total } = state.analise.progresso;
  f.style.width = (total ? atual / total * 100 : 0) + "%";
  l.textContent = "Buscando concursos oficiais… " + atual + "/" + total;
}

/* ============ Formatação ============ */
function anFmt(x, d){ if(x == null || !isFinite(x)) return "—"; return x.toLocaleString("pt-BR", { minimumFractionDigits: d, maximumFractionDigits: d }); }
function anPct(x, d){ return x == null || !isFinite(x) ? "—" : anFmt(x * 100, d == null ? 1 : d) + "%"; }
function anPv(p){ if(!isFinite(p)) return "—"; if(p < 0.0001) return "&lt; 0,0001"; return anFmt(p, 4); }
function anVered(g){
  if(!g || !isFinite(g.p)) return '<span class="an-verdict mute">amostra pequena demais</span>';
  return g.p >= 0.05 ? '<span class="an-verdict ok">Compatível com o acaso · p = ' + anPv(g.p) + '</span>'
                     : '<span class="an-verdict warn">Desvio detectado · p = ' + anPv(g.p) + '</span>';
}
function anZcls(z){ return z >= 1.96 ? "an-hot" : (z <= -1.96 ? "an-cold" : ""); }
function anStatLine(g){ return "χ² = " + anFmt(g.stat, 2) + " · gl = " + g.df + " · p = " + anPv(g.p); }
function anUm(x){ return x > 0 ? "1 em " + (x >= 100 ? Math.round(x).toLocaleString("pt-BR") : anFmt(x, x >= 10 ? 1 : 2)) : "—"; }

function anOrdenar(rows, ordem){
  const r = rows.slice();
  switch(ordem){
    case "freq": r.sort((x, y) => y.f - x.f || x.n - y.n); break;
    case "freqAsc": r.sort((x, y) => x.f - y.f || x.n - y.n); break;
    case "z": r.sort((x, y) => Math.abs(y.z) - Math.abs(x.z) || x.n - y.n); break;
    case "atraso": r.sort((x, y) => y.atual - x.atual || x.n - y.n); break;
    case "rec": r.sort((x, y) => y.rec - x.rec || x.n - y.n); break;
    default: r.sort((x, y) => x.n - y.n);
  }
  return r;
}
function anSelectOrdem(a){
  const ops = [["num", "Número"], ["freq", "Mais sorteadas"], ["freqAsc", "Menos sorteadas"], ["z", "Maior desvio (|z|)"], ["atraso", "Maior atraso atual"], ["rec", "Mais frequentes nos últimos concursos"]];
  return '<label class="an-note" style="display:inline-flex;align-items:center;gap:.5rem;">Ordenar por <select class="select" style="width:auto;height:2.25rem;padding:0 .6rem;" data-an-f="ordem">' +
    ops.map(o => '<option value="' + o[0] + '"' + (a.ordem === o[0] ? " selected" : "") + '>' + o[1] + '</option>').join("") + '</select></label>';
}

/* Cartão genérico de distribuição observada × exata */
function anCardDist(titulo, desc, rotulos, obs, probs, total, gof, extra){
  const rows = obs.map((o, i) => ({ r: rotulos[i], o: o, e: probs[i] })).filter(x => x.o > 0 || x.e >= 0.0005);
  const mx = Math.max.apply(null, rows.map(x => Math.max(x.o / total, x.e)).concat([1e-9]));
  const tr = rows.map(x => '<tr><td class="t">' + x.r + '</td><td>' + x.o + '</td><td>' + anPct(x.o / total) + '</td><td>' + anPct(x.e) + '</td><td>' + anFmt(x.e * total, 1) + '</td>' +
    '<td style="min-width:150px"><div class="an-bar"><i style="width:' + (x.o / total / mx * 100) + '%"></i></div><div class="an-bar esp"><i style="width:' + (x.e / mx * 100) + '%"></i></div></td></tr>').join("");
  return '<section class="panel"><div class="an-head"><h3 class="an-h4">' + titulo + '</h3>' + anVered(gof) + '</div>' +
    '<p class="an-note" style="margin-top:.4rem">' + desc + '</p>' + (extra || "") +
    '<div class="an-wrap"><table class="an-table"><thead><tr><th>Valor</th><th>Obs.</th><th>Obs. %</th><th>Esperado %</th><th>Esperado</th><th>Observado (cheio) × esperado (tracejado)</th></tr></thead><tbody>' + tr + '</tbody></table></div>' +
    (gof && isFinite(gof.p) ? '<p class="an-note" style="margin-top:.6rem">Teste de aderência: ' + anStatLine(gof) + '. Caselas com esperado &lt; 5 são agrupadas antes do teste.</p>' : '') + '</section>';
}
function anKpi(v, l){ return '<div class="an-kpi"><div class="v">' + v + '</div><div class="l">' + l + '</div></div>'; }


/* ============ Abas de resultados ============ */
function anTabResumo(R, a){
  const c = R.conf, de = R.periodo.de, ate = R.periodo.ate;
  const periodo = (de.data && ate.data) ? de.data + " → " + ate.data : "#" + de.numero + " → #" + ate.numero;
  const m = R.testes.length, x = R.testes.filter(t => t.p < 0.05).length;
  const pAcaso = x > 0 ? anBinomCauda(m, 0.05, x, true) : 1;
  const linhas = R.testes.map(t => '<tr><td class="t">' + t.nome + '</td><td>' + anFmt(t.stat, 2) + '</td><td>' + t.df + '</td><td>' + anPv(t.p) + '</td><td class="t">' +
    (t.p >= 0.05 ? '<span class="an-verdict ok">compatível com o acaso</span>' : '<span class="an-verdict warn">desvio (p &lt; 5%)</span>') + '</td></tr>').join("");
  return '<section class="panel"><h3 class="an-h4">Resumo da amostra</h3>' +
    '<div class="an-strip" style="margin-top:.75rem;">' +
      anKpi("#" + de.numero + " – #" + ate.numero, "Concursos (" + R.T + ")") +
      anKpi(periodo, "Período") +
      anKpi(R.Teff, "Sorteios analisados" + (R.perC > 1 ? " (2 por concurso)" : "")) +
      anKpi(R.N + " dezenas", "Universo (" + anP2(c.minNumero) + " a " + anP2(c.maxNumero) + ")") +
      anKpi(R.k + " por sorteio", "Dezenas sorteadas") +
      anKpi(anPct(R.p, 2), "Chance de cada dezena por sorteio") +
    '</div>' + (a.falhas ? '<p class="an-note" style="margin-top:.75rem;">⚠️ ' + a.falhas + ' concurso(s) não puderam ser carregados e ficaram de fora; os cálculos usam os ' + R.T + ' carregados.</p>' : '') +
    '</section>' +
    '<section class="panel"><div class="an-head"><h3 class="an-h4">Testes estatísticos exatos (' + m + ')</h3><span class="an-verdict ' + (x / m <= 0.15 ? 'ok' : 'warn') + '">' + x + ' de ' + m + ' com p &lt; 5%</span></div>' +
    '<p class="an-note" style="margin-top:.4rem;">Cada teste compara o que aconteceu na amostra com a distribuição <strong>exata</strong> de um sorteio perfeitamente aleatório (hipergeométrica, soma exata por programação dinâmica, ocupação por inclusão–exclusão). Se a loteria for honesta, cada teste isolado rejeita 5% das vezes por puro acaso — aqui, com ' + m + ' testes, o esperado é <strong>~' + anFmt(m * 0.05, 1) + '</strong> resultado(s) com p &lt; 5%' +
    (x > 0 ? ' (probabilidade aproximada de ver ' + x + ' ou mais só por acaso: ' + anPct(pAcaso, 0) + ', tratando os testes como independentes).' : '.') + '</p>' +
    '<div class="an-wrap"><table class="an-table"><thead><tr><th>Teste</th><th>χ²</th><th>gl</th><th>p-valor</th><th>Leitura</th></tr></thead><tbody>' + linhas + '</tbody></table></div>' +
    '<p class="an-note" style="margin-top:.6rem;">Interpretação honesta: um p-valor baixo só indica que aquela amostra se afastou do esperado; sorteios passados não alteram a chance do próximo (cada sorteio é independente). As abas seguintes mostram o detalhe de cada análise.</p></section>';
}

function anTabFreq(R, a){
  const c = R.chiFreq, rows = anOrdenar(R.freq, a.ordem);
  const mx = Math.max.apply(null, R.freq.map(r => r.f).concat([1]));
  const tr = rows.map(r => '<tr><td>' + anP2(r.n) + '</td><td>' + r.f + '</td><td>' + anPct(r.pct, 2) + '</td><td>' + anFmt(r.esp, 1) + '</td><td class="' + anZcls(r.z) + '">' + (r.z >= 0 ? "+" : "") + anFmt(r.z, 2) + '</td><td>' + r.rec + '</td>' +
    '<td style="min-width:130px"><div class="an-bar"><i style="width:' + (r.f / mx * 100) + '%"></i></div></td></tr>').join("");
  const top = R.freq.slice().sort((x, y) => y.f - x.f || x.n - y.n)[0], bot = R.freq.slice().sort((x, y) => x.f - y.f || x.n - y.n)[0];
  const maxZ = R.freq.reduce((m, r) => Math.max(m, Math.abs(r.z)), 0);
  return '<section class="panel"><div class="an-head"><h3 class="an-h4">Números mais sorteados</h3>' + anVered(c) + '</div>' +
    '<p class="an-note" style="margin-top:.4rem;">Cada dezena tem chance <strong>p = ' + R.k + '/' + R.N + ' = ' + anPct(R.p, 2) + '</strong> de sair em cada sorteio, logo em ' + R.Teff + ' sorteios o esperado é <strong>' + anFmt(R.E, 1) + ' ± ' + anFmt(R.sigma, 1) + '</strong> aparições (binomial exata). A coluna <em>z</em> mede quantos desvios-padrão a dezena está do esperado.</p>' +
    '<div class="an-strip" style="margin-top:.75rem;">' +
      anKpi(anP2(top.n) + " · " + top.f + "×", "Mais sorteada") + anKpi(anP2(bot.n) + " · " + bot.f + "×", "Menos sorteada") +
      anKpi(anFmt(maxZ, 2), "Maior |z| (limite Bonferroni " + anFmt(R.zBonf, 2) + ")") +
      anKpi(R.n196 + " (esp. ≈ " + anFmt(R.N * 0.05, 1) + ")", "Dezenas com |z| > 1,96") +
    '</div>' +
    '<p class="an-note" style="margin-top:.75rem;">Uniformidade global (χ² corrigido para sorteio sem reposição): ' + anStatLine(c) + '. ' +
    (R.nBonf === 0 ? 'Nenhuma dezena ultrapassa o limite de Bonferroni (|z| &gt; ' + anFmt(R.zBonf, 2) + '), ou seja, nenhuma frequência individual é estatisticamente distinguível do acaso ao se levar em conta que ' + R.N + ' dezenas foram testadas ao mesmo tempo.'
                       : R.nBonf + ' dezena(s) ultrapassa(m) o limite de Bonferroni (|z| &gt; ' + anFmt(R.zBonf, 2) + ') — vale conferir com uma amostra maior.') + '</p>' +
    '<div style="margin-top:.75rem;">' + anSelectOrdem(a) + '</div>' +
    '<div class="an-wrap"><table class="an-table"><thead><tr><th>Dezena</th><th>Vezes</th><th>% dos sorteios</th><th>Esperado</th><th>z</th><th>Últimos ' + R.Wd + '</th><th>Frequência</th></tr></thead><tbody>' + tr + '</tbody></table></div>' +
    '<p class="an-note" style="margin-top:.6rem;"><span class="an-hot">Laranja</span>: z ≥ 1,96 (acima do esperado) · <span class="an-cold">Azul</span>: z ≤ −1,96 (abaixo). Em ' + R.N + ' dezenas, cerca de ' + anFmt(R.N * 0.05, 1) + ' passam de 1,96 só por acaso. A coluna “Últimos ' + R.Wd + '” conta as aparições na janela recente (esperado ' + anFmt(R.Er, 1) + ').</p></section>';
}

function anCardCiclo(R){
  const cy = R.ciclo, falt = new Set(cy.faltam);
  const chips = R.U.map(n => '<span class="an-chip' + (falt.has(n) ? "" : " on") + '">' + anP2(n) + '</span>').join("");
  const comp = cy.completos;
  return '<section class="panel"><h3 class="an-h4">Ciclo das dezenas</h3>' +
    '<p class="an-note" style="margin-top:.4rem;">Um <strong>ciclo</strong> fecha quando todas as ' + R.N + ' dezenas já saíram ao menos uma vez desde o início dele (problema do colecionador, com sorteios de ' + R.k + ' dezenas). O número esperado de sorteios para fechar um ciclo, calculado de forma exata por inclusão–exclusão, é <strong>' + anFmt(cy.esperado, 2) + '</strong>.</p>' +
    '<div class="an-strip" style="margin-top:.75rem;">' +
      anKpi(comp.length, "Ciclos completos na amostra") +
      anKpi(cy.media != null ? anFmt(cy.media, 2) : "—", "Duração média observada") +
      anKpi(comp.length ? Math.min.apply(null, comp) + " – " + Math.max.apply(null, comp) : "—", "Menor – maior duração") +
      anKpi(anFmt(cy.esperado, 2), "Duração esperada (exata)") +
      anKpi(cy.atualDraws, "Sorteios no ciclo atual") +
      anKpi(cy.vistos + " / " + R.N, "Dezenas já saídas no ciclo atual") +
    '</div>' +
    '<p class="an-note" style="margin-top:.75rem;">' + (cy.faltam.length ? 'Ainda faltam <strong>' + cy.faltam.length + '</strong> dezena(s) para fechar o ciclo atual: <strong>' + cy.faltam.map(anP2).join(", ") + '</strong>.' : 'O ciclo acabou de fechar no último sorteio; um novo ciclo começa agora.') + '</p>' +
    '<div class="an-chips">' + chips + '</div>' +
    '<p class="an-note" style="margin-top:.5rem;">Destacadas: já saíram no ciclo atual · Apagadas: ainda não saíram. O ciclo atual é contado a partir do último fechamento dentro da amostra (o primeiro ciclo começa no concurso mais antigo carregado).</p></section>';
}

function anTabAtraso(R, a){
  const rows = anOrdenar(R.freq, a.ordem);
  const tr = rows.map(r => '<tr><td>' + anP2(r.n) + '</td><td>' + (r.nunca ? "≥ " : "") + r.atual + '</td><td class="' + (r.pAtraso < 0.05 ? "an-hot" : "") + '">' + anPct(r.pAtraso, r.pAtraso < 0.01 ? 2 : 1) + '</td><td>' + r.gapMax + '</td><td>' + (r.gapMed != null ? anFmt(r.gapMed, 1) : "—") + '</td><td>' + anFmt(R.gapEsp, 1) + '</td></tr>').join("");
  const mais = R.freq.slice().sort((x, y) => y.atual - x.atual || x.n - y.n)[0];
  return anCardCiclo(R) +
    '<section class="panel"><h3 class="an-h4">Atrasos (sorteios sem sair)</h3>' +
    '<p class="an-note" style="margin-top:.4rem;">O atraso de uma dezena segue uma distribuição geométrica: <strong>P(atraso ≥ g) = (1 − p)<sup>g</sup></strong>, com p = ' + anPct(R.p, 2) + '. O atraso médio esperado entre duas aparições é <strong>' + anFmt(R.gapEsp, 1) + '</strong> sorteios. A coluna “por acaso” mostra a probabilidade de uma dezena ficar pelo menos tão atrasada quanto está.</p>' +
    '<div class="an-strip" style="margin-top:.75rem;">' +
      anKpi(anP2(mais.n) + " · " + (mais.nunca ? "≥ " : "") + mais.atual, "Maior atraso atual") +
      anKpi(R.nAtraso5 + " (esp. ≈ " + anFmt(R.N * 0.05, 1) + ")", "Dezenas com P(por acaso) &lt; 5%") +
      anKpi(anFmt(R.gapEsp, 1), "Atraso médio esperado") +
    '</div>' +
    '<p class="an-note" style="margin-top:.75rem;"><strong>Atenção:</strong> estar atrasada não torna a dezena “devida”. A chance de sair no próximo sorteio continua exatamente ' + anPct(R.p, 2) + ' (o sorteio não tem memória). Este quadro serve para descrever a amostra, não para prever.</p>' +
    '<div style="margin-top:.75rem;">' + anSelectOrdem(a) + '</div>' +
    '<div class="an-wrap"><table class="an-table"><thead><tr><th>Dezena</th><th>Atraso atual</th><th>Por acaso (≥ atual)</th><th>Maior atraso</th><th>Atraso médio obs.</th><th>Atraso médio esp.</th></tr></thead><tbody>' + tr + '</tbody></table></div></section>';
}

function anTabEstrutura(R){
  const c = R.conf, k = R.k, N = R.N, e = R.est, U = R.U;
  const T = R.Teff;
  let html = "";
  const F = R.filtros;
  if(F.itens.length){
    const tr = F.itens.map(f => '<tr><td class="t">' + f.nome + '</td><td>' + anPct(f.teor, 1) + '</td><td>' + (f.obs != null ? anPct(f.obs, 1) : "—") + '</td></tr>').join("") +
      (F.conjunto != null ? '<tr><td class="t"><strong>Todos os filtros juntos</strong></td><td>—</td><td>' + anPct(F.conjunto, 1) + '</td></tr>' : "");
    html += '<section class="panel"><h3 class="an-h4">Seus filtros × a realidade</h3>' +
      '<p class="an-note" style="margin-top:.4rem;">Para jogos de <strong>' + F.nj + ' dezenas</strong>, a 2ª coluna é a fatia <strong>exata</strong> de todas as combinações possíveis que cada filtro deixa passar; a 3ª é a fatia dos sorteios reais da amostra que o filtro teria aceitado (' + (F.mesmoTam ? "o sorteio tem o mesmo tamanho do jogo" : "não comparável aqui: o sorteio tem " + k + " dezenas e o jogo " + F.nj) + ').</p>' +
      '<div class="an-wrap"><table class="an-table"><thead><tr><th>Filtro do aplicativo</th><th>Combinações aceitas (exato)</th><th>Sorteios reais aceitos</th></tr></thead><tbody>' + tr + '</tbody></table></div>' +
      '<p class="an-note" style="margin-top:.6rem;">Um bom filtro aceita quase todos os sorteios reais (para não descartar o próprio resultado) e, ao mesmo tempo, descarta uma boa parte das combinações improváveis.</p></section>';
  }
  html += anCardDist("Pares e ímpares", "Quantidade de dezenas ímpares em cada sorteio. Universo com " + e.impar.K + " ímpares e " + (N - e.impar.K) + " pares → distribuição hipergeométrica. Média esperada: " + anFmt(e.impar.mediaEsp, 2) + " · observada: " + anFmt(e.impar.mediaObs, 2) + " (z = " + anFmt(e.impar.z, 2) + ").",
    e.impar.obs.map((_, i) => i + " ímpar" + (i === 1 ? "" : "es") + " · " + (k - i) + " par" + (k - i === 1 ? "" : "es")), e.impar.obs, e.impar.probs, T, e.impar.gof);
  const prim = U.filter(anIsPrimo), fib = anFibonacci(U);
  html += anCardDist("Números primos", "Primos no universo (" + prim.length + "): " + prim.map(anP2).join(", ") + ". Média esperada " + anFmt(e.primos.mediaEsp, 2) + " por sorteio · observada " + anFmt(e.primos.mediaObs, 2) + " (z = " + anFmt(e.primos.z, 2) + ").",
    e.primos.obs.map((_, i) => i + " primo" + (i === 1 ? "" : "s")), e.primos.obs, e.primos.probs, T, e.primos.gof);
  html += anCardDist("Sequência de Fibonacci", "Números de Fibonacci no universo (" + fib.length + "): " + fib.map(anP2).join(", ") + ". Média esperada " + anFmt(e.fib.mediaEsp, 2) + " · observada " + anFmt(e.fib.mediaObs, 2) + " (z = " + anFmt(e.fib.z, 2) + ").",
    e.fib.obs.map((_, i) => i + " de Fibonacci"), e.fib.obs, e.fib.probs, T, e.fib.gof);
  if(e.moldura){
    html += anCardDist("Moldura do volante (Lotofácil)", "A moldura são as 16 dezenas da borda do volante 5×5; o miolo tem 9. Média esperada " + anFmt(e.moldura.mediaEsp, 2) + " dezenas da moldura por sorteio · observada " + anFmt(e.moldura.mediaObs, 2) + " (z = " + anFmt(e.moldura.z, 2) + ").",
      e.moldura.obs.map((_, i) => i + " na moldura · " + (k - i) + " no miolo"), e.moldura.obs, e.moldura.probs, T, e.moldura.gof);
  }
  const s = e.soma, bins = s.bins;
  html += anCardDist("Soma das dezenas",
    "A distribuição da soma de " + k + " dezenas distintas é calculada de forma <strong>exata</strong> (programação dinâmica sobre todas as combinações). Os intervalos abaixo são os decis exatos: cada um concentra ≈ 10% das combinações possíveis.",
    bins.map(b => b.lo + " – " + b.hi), s.obsBins, bins.map(b => b.prob), T, s.gof,
    '<div class="an-strip" style="margin-top:.75rem;">' +
      anKpi(anFmt(s.media, 1) + " (esp. " + anFmt(s.mediaEsp, 1) + ")", "Soma média · z = " + anFmt(s.z, 2)) +
      anKpi(anFmt(s.dp, 1) + " (esp. " + anFmt(s.dpEsp, 1) + ")", "Desvio-padrão") +
      anKpi(s.min + " – " + s.max, "Menor – maior soma") +
      anKpi(s.tip.a + " – " + s.tip.b, "Faixa típica (≥ 80% das combinações)") +
      anKpi(anPct(s.dentroTip, 0), "Sorteios dentro da faixa típica") +
    '</div>');
  html += anCardDist("Dezenas consecutivas (pares vizinhos)", "Quantos pares de números vizinhos (n e n+1) aparecem no mesmo sorteio. Distribuição exata: P(r) = C(k−1, r) · C(N−k+1, k−r) / C(N, k). Média esperada " + anFmt(e.adj.mediaEsp, 2) + " · observada " + anFmt(e.adj.mediaObs, 2) + ".",
    e.adj.obs.map((_, i) => i + " par" + (i === 1 ? "" : "es") + " vizinho" + (i === 1 ? "" : "s")), e.adj.obs, e.adj.probs, T, e.adj.gof);
  html += anCardDist("Maior sequência de consecutivas", "Tamanho da maior sequência de números seguidos dentro do sorteio (ex.: 17-18-19 = 3). Distribuição exata por composições de inteiros.",
    e.run.obs.map((_, i) => i + " seguida" + (i === 1 ? "" : "s")), e.run.obs, e.run.probs, T, e.run.gof);
  if(e.rep.gof){
    html += anCardDist("Repetidas do sorteio anterior", "Quantas dezenas do sorteio anterior se repetem no seguinte" + (R.perC > 1 ? " (1º com 1º e 2º com 2º, de concursos consecutivos)" : "") + ". Hipergeométrica exata; média esperada k²/N = " + anFmt(e.rep.mediaEsp, 2) + " · observada " + anFmt(e.rep.mediaObs, 2) + " (" + e.rep.total + " pares de sorteios).",
      e.rep.obs.map((_, i) => i + " repetida" + (i === 1 ? "" : "s")), e.rep.obs, e.rep.probs, e.rep.total, e.rep.gof);
  }
  return html;
}

function anTabVolante(R){
  let html = '<section class="panel"><h3 class="an-h4">Distribuição no volante</h3><p class="an-note" style="margin-top:.4rem;">Para cada agrupamento do volante, compara-se o total de dezenas sorteadas em cada grupo com o esperado exato (hipergeométrica multivariada: variância corrigida pelo fator (N−k)/(N−1) do sorteio sem reposição) e testa-se o conjunto com χ². A segunda tabela mostra a <strong>dispersão</strong>: quantos grupos distintos cada sorteio toca, com a distribuição exata por inclusão–exclusão.</p></section>';
  R.grupos.forEach(g => {
    const mxz = Math.max.apply(null, g.linhas.map(l => l.obs).concat([1]));
    const tr = g.linhas.map(l => '<tr><td class="t">' + l.rotulo + '</td><td>' + l.tam + '</td><td>' + l.obs + '</td><td>' + anFmt(l.mediaObs, 2) + '</td><td>' + anFmt(l.mediaEsp, 2) + '</td><td class="' + anZcls(l.z) + '">' + (l.z >= 0 ? "+" : "") + anFmt(l.z, 2) + '</td>' +
      '<td style="min-width:120px"><div class="an-bar"><i style="width:' + (l.obs / mxz * 100) + '%"></i></div></td></tr>').join("");
    const oc = g.occ, nG = g.linhas.length;
    const rowsOc = oc.obs.map((o, i) => ({ i: i, o: o, e: oc.probs[i] })).filter(x => x.o > 0 || x.e >= 0.0005);
    const trOc = rowsOc.map(x => '<tr><td class="t">' + x.i + ' de ' + nG + ' grupos</td><td>' + x.o + '</td><td>' + anPct(x.o / R.Teff) + '</td><td>' + anPct(x.e) + '</td><td>' + anFmt(x.e * R.Teff, 1) + '</td></tr>').join("");
    html += '<section class="panel"><div class="an-head"><h3 class="an-h4">' + g.titulo + '</h3>' + anVered(g) + '</div><p class="an-note" style="margin-top:.4rem;">' + g.desc + '</p>' +
      '<div class="an-wrap"><table class="an-table"><thead><tr><th>Grupo</th><th>Dezenas</th><th>Total sorteado</th><th>Média / sorteio</th><th>Esperado / sorteio</th><th>z</th><th></th></tr></thead><tbody>' + tr + '</tbody></table></div>' +
      '<p class="an-note" style="margin-top:.6rem;">Teste dos totais: ' + anStatLine(g) + '.</p>' +
      '<div class="an-head" style="margin-top:1rem;"><h4 class="an-h4" style="font-size:.875rem;">Dispersão (grupos distintos tocados por sorteio)</h4>' + anVered(oc.gof) + '</div>' +
      '<div class="an-wrap"><table class="an-table"><thead><tr><th>Grupos tocados</th><th>Obs.</th><th>Obs. %</th><th>Esperado %</th><th>Esperado</th></tr></thead><tbody>' + trOc + '</tbody></table></div>' +
      '<p class="an-note" style="margin-top:.6rem;">Média observada ' + anFmt(oc.mediaObs, 2) + ' · esperada ' + anFmt(oc.mediaEsp, 2) + (isFinite(oc.gof.p) ? ' · ' + anStatLine(oc.gof) : '') + '.</p></section>';
  });
  return html;
}

function anTabPares(R){
  const rowsHtml = lista => lista.map(x => '<tr><td class="t">' + x.itens.map(anP2).join(" – ") + '</td><td>' + x.f + '</td><td>' + anFmt(x.esp, 2) + '</td><td class="' + (x.pAdj < 0.05 ? "an-hot" : "") + '">' + anPv(x.pAdj) + '</td></tr>').join("");
  const head = '<thead><tr><th>Combinação</th><th>Vezes</th><th>Esperado</th><th>p ajustado (Bonferroni)</th></tr></thead>';
  const d = R.duplas, t = R.trios;
  const sigD = d.top.filter(x => x.pAdj < 0.05).length, sigT = t.top.filter(x => x.pAdj < 0.05).length;
  return '<section class="panel"><h3 class="an-h4">Duplas mais e menos frequentes</h3>' +
    '<p class="an-note" style="margin-top:.4rem;">Existem ' + d.M.toLocaleString("pt-BR") + ' duplas possíveis; cada uma tem chance q = k(k−1)/(N(N−1)) = ' + anPct(d.q, 3) + ' por sorteio, esperado <strong>' + anFmt(d.esp, 2) + '</strong> aparições em ' + R.Teff + ' sorteios. O p ajustado é a cauda binomial exata multiplicada pelo nº de duplas (Bonferroni): como o topo de qualquer ranking sempre parece “especial”, só vale destacar quando p ajustado &lt; 5%.</p>' +
    '<div class="an-grid2" style="margin-top:.75rem;"><div><p class="an-note"><strong>Mais frequentes</strong></p><div class="an-wrap"><table class="an-table">' + head + '<tbody>' + rowsHtml(d.top) + '</tbody></table></div></div>' +
    '<div><p class="an-note"><strong>Menos frequentes</strong></p><div class="an-wrap"><table class="an-table">' + head + '<tbody>' + rowsHtml(d.baixo) + '</tbody></table></div></div></div>' +
    '<p class="an-note" style="margin-top:.6rem;">' + (sigD === 0 ? 'Nenhuma dupla do topo é estatisticamente distinguível do acaso após o ajuste.' : sigD + ' dupla(s) do topo com p ajustado &lt; 5%.') + '</p></section>' +
    '<section class="panel"><h3 class="an-h4">Trios mais frequentes</h3>' +
    '<p class="an-note" style="margin-top:.4rem;">Existem ' + t.M.toLocaleString("pt-BR") + ' trios possíveis; esperado por trio: <strong>' + anFmt(t.esp, 3) + '</strong> aparições. Mesmo ajuste de Bonferroni.</p>' +
    '<div class="an-wrap"><table class="an-table">' + head + '<tbody>' + rowsHtml(t.top) + '</tbody></table></div>' +
    '<p class="an-note" style="margin-top:.6rem;">' + (sigT === 0 ? 'Nenhum trio do topo é estatisticamente distinguível do acaso após o ajuste.' : sigT + ' trio(s) do topo com p ajustado &lt; 5%.') + '</p></section>';
}

function anTabEsp(R, a){
  const c = R.conf; let html = "";
  if(c.key === "duplasena" && R.esp.ds){
    const d = R.esp.ds, T = R.T;
    html += '<section class="panel"><h3 class="an-h4">Dupla Sena — 1º × 2º sorteio</h3><p class="an-note" style="margin-top:.4rem;">Cada concurso tem dois sorteios independentes de 6 dezenas entre 50. Abaixo, uma análise só do 1º sorteio, só do 2º e a coincidência de dezenas entre os dois no mesmo concurso (esperado ' + anFmt(d.mediaEsp, 2) + ' em comum; observado ' + anFmt(d.mediaObs, 2) + ').</p>' +
      '<div class="an-strip" style="margin-top:.75rem;">' + anKpi(anPv(d.f1.p), "p — uniformidade do 1º sorteio") + anKpi(anPv(d.f2.p), "p — uniformidade do 2º sorteio") + '</div></section>';
    html += anCardDist("Dezenas em comum entre o 1º e o 2º sorteio", "Hipergeométrica exata: P(x) = C(6,x)·C(44,6−x)/C(50,6).", d.ov.map((_, i) => i + " em comum"), d.ov, d.probs, T, d.gof);
  }
  if(c.key === "diadesorte"){
    const m = R.esp.mes;
    if(!m){ html += '<section class="panel"><h3 class="an-h4">Mês de Sorte</h3><p class="an-note" style="margin-top:.4rem;">Os resultados carregados não trazem o Mês de Sorte, então esta análise não pôde ser feita.</p></section>'; }
    else html += anCardDist("Mês de Sorte", "Cada concurso sorteia também um mês entre 12, com chance 1/12 (8,33%) cada. Esperado " + anFmt(m.total / 12, 1) + " por mês em " + m.total + " concursos.", AN_MESES_LABEL, m.cont, new Array(12).fill(1 / 12), m.total, m.gof);
  }
  return html;
}

const AN_PREMIOS = {
  megasena: [{ h: 6, t: "Sena" }, { h: 5, t: "Quina" }, { h: 4, t: "Quadra" }],
  lotofacil: [{ h: 15, t: "15 acertos" }, { h: 14, t: "14 acertos" }, { h: 13, t: "13 acertos" }, { h: 12, t: "12 acertos" }, { h: 11, t: "11 acertos" }],
  duplasena: [{ h: 6, t: "Sena" }, { h: 5, t: "Quina" }, { h: 4, t: "Quadra" }, { h: 3, t: "Terno" }],
  lotomania: [{ h: 20, t: "20 acertos" }, { h: 19, t: "19 acertos" }, { h: 18, t: "18 acertos" }, { h: 17, t: "17 acertos" }, { h: 16, t: "16 acertos" }, { h: 0, t: "Nenhum acerto" }],
  diadesorte: [{ h: 7, t: "7 acertos" }, { h: 6, t: "6 acertos" }, { h: 5, t: "5 acertos" }, { h: 4, t: "4 acertos" }],
};
function anProbFmt(p){
  const x = p * 100;
  if(!(x > 0)) return "0%";
  if(x >= 0.01) return anFmt(x, 2) + "%";
  if(x >= 0.0001) return anFmt(x, 5) + "%";
  const e = Math.floor(Math.log10(x)), m = x / Math.pow(10, e);
  const sup = String(e).replace(/-/g, "⁻").replace(/\d/g, dg => "⁰¹²³⁴⁵⁶⁷⁸⁹"[dg]);
  return anFmt(m, 2) + " × 10" + sup + "%";
}
function anTabProb(R, a){
  const c = R.conf, N = R.N, k = R.k, kj = c.dezenasPorJogo, tam = DESDOB_TAMANHO[c.key];
  const n = a.probTam || kj, total = anCBig(N, k), ds = c.key === "duplasena";
  const tr = AN_PREMIOS[c.key].map(t => {
    const ways = anCBig(n, t.h) * anCBig(N - n, k - t.h);
    const pr = Number(ways) / Number(total), um = pr > 0 ? 1 / pr : 0;
    return '<tr><td class="t">' + t.t + '</td><td>' + t.h + '</td><td>' + anFmtBig(ways) + '</td><td>' + anProbFmt(pr) + '</td><td>' + anUm(um) + '</td>' +
      (ds ? '<td>' + anUm(pr > 0 ? 1 / (1 - (1 - pr) * (1 - pr)) : 0) + '</td>' : '') + '</tr>';
  }).join("");
  const opts = []; for(let i = tam.min; i <= tam.max; i++) opts.push('<option value="' + i + '"' + (i === n ? " selected" : "") + '>' + i + ' dezenas</option>');
  return '<section class="panel"><h3 class="an-h4">Probabilidades exatas de acerto</h3>' +
    '<p class="an-note" style="margin-top:.4rem;">Para uma aposta de <strong>n</strong> dezenas, a chance de acertar exatamente <strong>h</strong> das ' + k + ' sorteadas é hipergeométrica: P(h) = C(n,h) · C(' + N + '−n, ' + k + '−h) / C(' + N + ', ' + k + '). O espaço total tem <strong>' + anFmtBig(total) + '</strong> combinações.</p>' +
    '<div style="margin-top:.75rem;"><label class="an-note" style="display:inline-flex;align-items:center;gap:.5rem;">Tamanho da aposta <select class="select" style="width:auto;height:2.25rem;padding:0 .6rem;" data-an-f="probTam">' + opts.join("") + '</select></label></div>' +
    '<div class="an-strip" style="margin-top:.75rem;">' + anKpi(anFmtBig(anCBig(n, kj)), "Jogos simples de " + kj + " dezenas cobertos") + anKpi(anFmt(n * k / N, 2), "Acertos esperados (n·k/N)") + anKpi(anFmtBig(total), "Combinações possíveis") + '</div>' +
    '<div class="an-wrap"><table class="an-table"><thead><tr><th>Faixa</th><th>Acertos</th><th>Combinações favoráveis</th><th>Probabilidade</th><th>Chance</th>' + (ds ? '<th>Em pelo menos 1 dos 2 sorteios</th>' : '') + '</tr></thead><tbody>' + tr + '</tbody></table></div>' +
    (c.key === "diadesorte" ? '<p class="an-note" style="margin-top:.6rem;">Mês de Sorte: acertar o mês sorteado tem chance 1 em 12 (8,33%), independente das 7 dezenas.</p>' : '') +
    (ds ? '<p class="an-note" style="margin-top:.6rem;">Os dois sorteios são independentes: a chance de pontuar em pelo menos um é 1 − (1 − p)².</p>' : '') +
    '<p class="an-note" style="margin-top:.6rem;">Aumentar o tamanho da aposta multiplica a chance na proporção do nº de jogos simples cobertos, e o custo cresce na mesma proporção.</p></section>';
}


