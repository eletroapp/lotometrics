  const c = desdobConf();
  list.innerHTML = jogos.map((jogo, i) => {
    const soma = jogo.reduce((a,b)=>a+b, 0);
    const bolas = jogo.map(n => `<span class="ball" style="background-color:${c.accent}; color:var(--on-accent);">${pad(n)}</span>`).join("");
    return `
      <li class="cascata-card">
        <div class="jogo-row">
          <span class="jogo-idx">Jogo ${pad(i+1)} · ${jogo.length} dezenas</span>
