// Aceita linhas no formato exportado pelo app ("Jogo 01:  02  05  12...",
// com ou sem "| espelho:" / "+ extra"), ou apenas dezenas soltas por linha.
// Quando um jogo foi exportado em PDF e quebrou em mais de uma linha (ex.:
// Lotomania, com 50 dezenas, não cabe numa linha só), as linhas de
// continuação (que não começam com "Jogo NN:") são acumuladas junto ao
// jogo anterior até completar a quantidade mínima de dezenas da
// modalidade. Isso evita que a quebra de linha do PDF vire um jogo
// "fantasma" com poucas dezenas.
function parseJogosMultilinha(texto, c){
  if(!texto) return { jogos: [], ignoradas: 0 };
  const linhasComConteudo = texto.split("\n")
    .filter(l => l.trim() !== "")
    // descarta cabeçalho/rodapé do PDF exportado (título, subtítulo e data/hora),
    // a linha "Dezenas escolhidas" do cabeçalho do PDF de Desdobramento (presente
    // em todas as modalidades — megasena, lotofacil, duplasena, lotomania e
    // diadesorte, pois é a mesma função de exportação para todas) e linhas de
    // espelho, que não são jogos a conferir.
    .filter(l => !/lotometrics/i.test(l))
    .filter(l => !/^\s*dezenas\s+escolhidas\b/i.test(l))
    .filter(l => !/^\s*\d{1,2}\/\d{1,2}\/\d{2,4}[,]?\s*\d{1,2}:\d{2}/.test(l))
    .filter(l => !/^\s*espelho\s*:?/i.test(l));

  const jogos = [];
  let ignoradas = 0;
  let acumulado = [];

  function flush(){
    if(acumulado.length === 0) return;
    const nums = [...new Set(acumulado)].sort((a,b)=>a-b);
    if(nums.length >= c.dezenasPorJogo){
      jogos.push(nums);
    } else if(nums.length >= 2){
      // tinha alguns números, mas não o suficiente para ser uma aposta
      // válida dessa modalidade — ignora em vez de aceitar como jogo errado.
      ignoradas++;
    }
    acumulado = [];
  }

  linhasComConteudo.forEach(linhaBruta => {
    const iniciaNovoJogo = /^\s*jogo\s*\d+\s*:?/i.test(linhaBruta);
    // uma linha "Jogo NN:" sempre encerra o jogo anterior (mesmo que
    // ele ainda esteja incompleto) antes de começar um novo acúmulo.
    if(iniciaNovoJogo){
      flush();
    }
    const limpa = linhaBruta
      .replace(/^\s*jogo\s*\d+\s*:?/i, "")
      .split("|")[0]
      .split(/\+\s*extra/i)[0];
    const nums = limpa.replace(/[^\d]/g, " ").trim().split(/\s+/).filter(Boolean)
      .map(n => parseInt(n, 10))
      .filter(n => !isNaN(n) && n >= c.minNumero && n <= c.maxNumero);

    acumulado.push(...nums);

    // assim que atingir a quantidade mínima de dezenas da modalidade,
    // fecha o jogo — cobre tanto o caso de uma linha só (texto colado
    // manualmente, um jogo por linha) quanto o de várias linhas de
    // continuação vindas de um PDF quebrado.
    if(new Set(acumulado).size >= c.dezenasPorJogo){
      flush();
    }
  });
  flush();

  return { jogos, ignoradas };
}

